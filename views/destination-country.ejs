<%
  const tourText = dest.tourCount + ' ' + (dest.tourCount === 1 ? 'tour' : 'tours');
  const hasParks = parks.length > 0;
  const hasTours = tours && tours.length > 0;
  // sections alternate white / tinted; the closing call to action takes the opposite of the last one
  const lastIsTinted = hasTours ? !hasParks : hasParks;
%>
<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero ds-hero">
  <div class="page-hero-bg"><%- image({ src: dest.image, alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <a href="/destinations">Destinations</a> <i class="fa-solid fa-angle-right"></i> <span><%= dest.name %></span></nav>
    <span class="badge badge-accent ds-hero-badge"><%= dest.subtitle %></span>
    <h1><%= dest.name %></h1>
    <p class="sx-hero-sub"><%= dest.tagline %></p>
    <ul class="sx-chips">
      <li><i class="fa-solid fa-route" aria-hidden="true"></i> <%= tourText %> available</li>
      <% if (hasParks) { %><li><i class="fa-solid fa-tree" aria-hidden="true"></i> <%= parks.length %> national parks</li><% } %>
    </ul>
  </div>
</section>

<!-- ═══════════════ ABOUT ═══════════════ -->
<section class="sx" id="about-country">
  <div class="container">
    <div class="sx-split">
      <div class="reveal-left">
        <span class="sx-eyebrow">About <%= dest.name %></span>
        <h2><%= dest.name %>: <%= dest.subtitle %></h2>
        <p class="sx-lead"><%= dest.description %></p>
        <div class="ds-about-actions">
          <a href="/tours" class="btn btn-green">View all <%= dest.name %> tours <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/contact" class="btn btn-outline-dark">Plan my trip</a>
        </div>
      </div>
      <div class="ds-about-media reveal-right">
        <div class="ds-about-photo">
          <%- image({ src: dest.image, alt: dest.name, sizes: '(min-width: 1024px) 45vw, 100vw', fill: true }) %>
        </div>
        <div class="sx-badge">
          <strong><%= tourText %></strong>
          <span>Available now</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ PARKS (Uganda) ═══════════════ -->
<% if (hasParks) { %>
<section class="sx sx--alt" id="parks">
  <div class="container">
    <header class="sx-head reveal">
      <div>
        <span class="sx-eyebrow">National parks</span>
        <h2>Explore <%= dest.name %>'s national parks</h2>
      </div>
    </header>
    <div class="ds-parks reveal-grid">
      <% parks.forEach(park => { %>
        <%- include('partials/park-card', { park }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ TOURS ═══════════════ -->
<% if (hasTours) { %>
<section class="sx<%= hasParks ? '' : ' sx--alt' %> ds-tours" id="packages">
  <div class="container">
    <header class="sx-head reveal">
      <div>
        <span class="sx-eyebrow">Safari packages</span>
        <h2><%= dest.name %> safari packages</h2>
      </div>
      <a class="sx-link hide-mobile" href="/tours">All tours <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>
    <div class="tours-grid reveal-grid">
      <% tours.forEach(tour => { %>
        <%- include('partials/tour-card', { tour }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: lastIsTinted ? 'plain' : 'alt',
  title: 'Plan your ' + dest.name + ' adventure',
  text: 'Let our expert team craft your perfect ' + dest.name + ' safari itinerary. Contact us today.',
  primary: { href: '/contact', label: 'Get a custom quote' },
  secondary: { href: '/tours', label: 'All tours' }
}) %>
