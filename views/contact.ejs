<!-- Hero -->
<section class="page-hero" style="min-height:380px;">
  <div class="page-hero-bg" style="background-image:url('/images/gorilla.png');"></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>Contact</span></nav>
    <h1 style="color:#fff;">Plan Your Adventure</h1>
    <p style="color:rgba(255,255,255,0.8); max-width:560px; margin-top:12px; font-size:1.05rem;">
      Our expert team responds within 24 hours. No payment required at this stage — just tell us your dream safari!
    </p>
  </div>
</section>

<!-- Contact Section -->
<section class="section" style="background:var(--surface-alt);">
  <div class="container">
    <div class="grid-2" style="gap:48px; align-items:start;">

      <!-- Contact Info Left -->
      <div class="reveal-left">
        <div class="contact-info-card">
          <div class="contact-info-top"></div>
          <div class="contact-info-body">
            <div class="contact-label">Get In Touch</div>
            <div class="contact-heading">We'd Love to Hear From You</div>

            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-solid fa-location-dot"></i></div>
              <div>
                <div class="contact-detail-label">Address</div>
                <div class="contact-detail-value">8FF4+GH3 Kyanyanya Trading Center, LUKAAWA PLAZA, Buloba, Busiro county</div>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-solid fa-phone"></i></div>
              <div>
                <div class="contact-detail-label">Phone</div>
                <div class="contact-detail-value">
                  <a href="tel:+256767936590">+256 767 936 590</a><br>
                  <a href="tel:+256744320330">+256 744 320 330</a>
                </div>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-solid fa-envelope"></i></div>
              <div>
                <div class="contact-detail-label">Email</div>
                <div class="contact-detail-value"><a href="mailto:info@tripsandadventures.co.ug">info@tripsandadventures.co.ug</a></div>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-solid fa-globe"></i></div>
              <div>
                <div class="contact-detail-label">Website</div>
                <div class="contact-detail-value"><a href="https://tripsandadventures.co.ug" target="_blank" rel="noopener">tripsandadventures.co.ug</a></div>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-brands fa-whatsapp"></i></div>
              <div>
                <div class="contact-detail-label">WhatsApp</div>
                <div class="contact-detail-value">
                  <a href="https://wa.me/256767936590?text=Hello%20Conservation%20Trips%20%26%20Adventures!%20I'm%20interested%20in%20booking%20a%20Uganda%20safari." target="_blank" rel="noopener">
                    Chat on WhatsApp — +256 767 936 590
                  </a>
                </div>
              </div>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon"><i class="fa-solid fa-clock"></i></div>
              <div>
                <div class="contact-detail-label">Working Hours</div>
                <div class="contact-detail-value">Mon–Sat: 8:00am – 6:00pm EAT<br>Sun: 10:00am – 4:00pm EAT</div>
              </div>
            </div>

            <div class="contact-social">
              <a href="https://www.facebook.com/tripsandadventures" target="_blank" rel="noopener" class="contact-social-btn" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
              <a href="https://www.instagram.com/trips_and_adventures.1" target="_blank" rel="noopener" class="contact-social-btn" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
              <a href="https://x.com/conservation_t" target="_blank" rel="noopener" class="contact-social-btn" aria-label="X / Twitter"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="https://www.tiktok.com/@conservationtrips" target="_blank" rel="noopener" class="contact-social-btn" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
            </div>

            <div class="map-wrap">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d255281.19907959017!2d32.47195744609375!3d0.31628217578947134!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x177dbc0f9d74b39b%3A0x4538b8915e50cf55!2sBuloba%2C%20Uganda!5e0!3m2!1sen!2sus!4v1234567890"
                loading="lazy"
                title="Conservation Trips & Adventures location in Buloba, Uganda"
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- Multi-Step Form Right -->
      <div class="reveal-right">
        <div class="booking-form-card">
          <div class="section-label" style="margin-bottom:8px;"><i class="fa-solid fa-compass"></i> Safari Enquiry</div>
          <h2 style="color:var(--dark); font-size:1.8rem; margin-bottom:8px;">Plan Your Perfect Safari</h2>
          <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:28px;">
            Fill in 3 quick steps and we'll get back to you within 24 hours with a personalised quote.
          </p>

          <form class="booking-form" id="booking-form" novalidate>

            <!-- Progress Bar -->
            <div class="progress-bar-wrap">
              <div class="progress-steps">
                <div class="progress-step">
                  <div class="step-circle active" id="sc-1">1</div>
                  <div class="step-line" id="sl-1"></div>
                </div>
                <div class="progress-step">
                  <div class="step-circle" id="sc-2">2</div>
                  <div class="step-line" id="sl-2"></div>
                </div>
                <div class="progress-step" style="flex:0;">
                  <div class="step-circle" id="sc-3">3</div>
                </div>
              </div>
              <div class="progress-labels">
                <div class="step-label active" id="sl-label-1">Trip Details</div>
                <div class="step-label" id="sl-label-2">Your Details</div>
                <div class="step-label" id="sl-label-3">Extra Info</div>
              </div>
            </div>

            <!-- STEP 1 -->
            <div class="form-step active" id="step-1">
              <h4 style="margin-bottom:20px; color:var(--dark);">What kind of safari are you dreaming of?</h4>
              <input type="hidden" id="safari_type" name="safari_type" value="">
              <div class="safari-type-grid">
                <div class="safari-type-card" data-value="Gorilla Trekking"><i class="fa-solid fa-paw"></i><span>Gorilla Trek</span></div>
                <div class="safari-type-card" data-value="Wildlife Safari"><i class="fa-solid fa-hippo"></i><span>Wildlife Safari</span></div>
                <div class="safari-type-card" data-value="Primate Safari"><i class="fa-solid fa-tree"></i><span>Primate Trek</span></div>
                <div class="safari-type-card" data-value="Mountain Climbing"><i class="fa-solid fa-mountain"></i><span>Mountain Climb</span></div>
                <div class="safari-type-card" data-value="Cultural Tour"><i class="fa-solid fa-masks-theater"></i><span>Cultural Tour</span></div>
                <div class="safari-type-card" data-value="Custom Safari"><i class="fa-solid fa-star"></i><span>Custom Safari</span></div>
              </div>

              <h4 style="margin-bottom:12px; color:var(--dark);">How many days?</h4>
              <input type="hidden" id="duration_range" name="duration_range" value="">
              <div class="duration-pills">
                <div class="duration-pill" data-value="1-3 days">1–3 Days</div>
                <div class="duration-pill" data-value="4-6 days">4–6 Days</div>
                <div class="duration-pill" data-value="7-10 days">7–10 Days</div>
                <div class="duration-pill" data-value="10+ days">10+ Days</div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="travel_month">Travel Month</label>
                  <select id="travel_month" name="travel_month" class="form-control">
                    <option value="">Select month...</option>
                    <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
                  </select>
                </div>
                <div class="form-group">
                  <label for="travel_year">Year</label>
                  <select id="travel_year" name="travel_year" class="form-control">
                    <option value="2025">2025</option>
                    <option value="2026" selected>2026</option>
                    <option value="2027">2027</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="group_size">Group Size</label>
                <input type="number" id="group_size" name="group_size" class="form-control" placeholder="2" min="1" max="50" value="2">
              </div>
              <button type="button" class="btn btn-primary step-next" style="width:100%; justify-content:center;">
                Next: Your Details <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>

            <!-- STEP 2 -->
            <div class="form-step" id="step-2">
              <h4 style="margin-bottom:20px; color:var(--dark);">Tell us about yourself</h4>
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name *</label>
                  <input type="text" id="firstName" name="firstName" class="form-control" placeholder="Jane" required>
                  <div class="form-error"></div>
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name *</label>
                  <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Smith" required>
                  <div class="form-error"></div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email Address *</label>
                  <input type="email" id="email" name="email" class="form-control" placeholder="jane@example.com" required>
                  <div class="form-error"></div>
                </div>
                <div class="form-group">
                  <label for="phone">Phone / WhatsApp</label>
                  <input type="tel" id="phone" name="phone" class="form-control" placeholder="+1 234 567 8900">
                </div>
              </div>
              <div class="form-group">
                <label for="country">Country of Origin</label>
                <input type="text" id="country" name="country" class="form-control" placeholder="United States">
              </div>
              <div class="form-group">
                <label for="heard">How did you hear about us?</label>
                <select id="heard" name="heard" class="form-control">
                  <option value="">Please select...</option>
                  <option>Google Search</option>
                  <option>TripAdvisor</option>
                  <option>Social Media</option>
                  <option>Friend / Family Referral</option>
                  <option>Travel Blog</option>
                  <option>SafariBookings.com</option>
                  <option>Other</option>
                </select>
              </div>
              <div style="display:flex; gap:12px;">
                <button type="button" class="btn btn-outline-dark step-back" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                <button type="button" class="btn btn-primary step-next" style="flex:2; justify-content:center;">
                  Next: Extra Info <i class="fa-solid fa-arrow-right"></i>
                </button>
              </div>
            </div>

            <!-- STEP 3 -->
            <div class="form-step" id="step-3">
              <h4 style="margin-bottom:20px; color:var(--dark);">Almost done! A few more details</h4>

              <div class="form-group">
                <label>Which destinations interest you? <span style="font-weight:400; color:var(--text-muted);">(tick all that apply)</span></label>
                <div class="destinations-grid">
                  <% ['Bwindi (Gorillas)', 'Queen Elizabeth NP', 'Kibale (Chimps)', 'Murchison Falls', 'Kidepo Valley', 'Lake Mburo', 'Kenya / Masai Mara', 'Mount Kilimanjaro'].forEach(dest => { %>
                  <label class="checkbox-group">
                    <input type="checkbox" name="destinations" value="<%= dest %>">
                    <span><%= dest %></span>
                  </label>
                  <% }) %>
                </div>
              </div>

              <div class="form-group">
                <label>Accommodation Preference</label>
                <input type="hidden" id="accommodation" name="accommodation" value="">
                <div class="accommodation-options">
                  <div class="accom-card" data-value="Budget"><i class="fa-solid fa-tent"></i><span>Budget</span></div>
                  <div class="accom-card" data-value="Mid-range"><i class="fa-solid fa-hotel"></i><span>Mid-range</span></div>
                  <div class="accom-card" data-value="Luxury"><i class="fa-solid fa-gem"></i><span>Luxury</span></div>
                </div>
              </div>

              <div class="form-group">
                <label for="requirements">Special Requirements</label>
                <textarea id="requirements" name="requirements" class="form-control" rows="3" placeholder="Dietary needs, medical conditions, accessibility requirements, special occasions..."></textarea>
              </div>

              <div class="form-group">
                <label class="checkbox-group">
                  <input type="checkbox" name="terms" id="terms" required>
                  <span>I agree to the <a href="/privacy" style="color:var(--primary);">Privacy Policy</a> and <a href="/terms" style="color:var(--primary);">Terms of Service</a></span>
                </label>
                <div class="form-error"></div>
              </div>

              <div style="display:flex; gap:12px;">
                <button type="button" class="btn btn-outline-dark step-back" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                <button type="submit" class="btn btn-primary" style="flex:2; justify-content:center; overflow:hidden;">
                  Send Enquiry <i class="fa-solid fa-paper-plane"></i>
                </button>
              </div>
            </div>

            <!-- Success Screen -->
            <div class="success-screen" id="booking-success">
              <div class="success-checkmark">
                <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                  <circle class="checkmark-circle" cx="40" cy="40" r="38"/>
                  <path class="checkmark-line" d="M20,42 L34,56 L60,28"/>
                </svg>
              </div>
              <h3 style="color:var(--dark); margin-bottom:10px;">Thank you, <span class="success-first-name">Explorer</span>!</h3>
              <p style="color:var(--text-muted); margin-bottom:24px;">We've received your safari enquiry and will be in touch within <strong>24 hours</strong> with a personalised itinerary and quote.</p>
              <a href="/" class="btn btn-green">Return Home <i class="fa-solid fa-arrow-right"></i></a>
            </div>

          </form>
        </div>
      </div>

    </div>
  </div>
</section>

