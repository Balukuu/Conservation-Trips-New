  <div class="cta-strip-content container reveal">
    <h2>Prefer to Talk? We're Here!</h2>
    <p>Our team is available 7 days a week to answer your questions and start planning your dream East Africa safari.</p>
    <div class="cta-contact-row">
      <a href="tel:+256767936590" class="cta-contact-item"><i class="fa-solid fa-phone"></i> +256 767 936 590</a>
      <a href="mailto:info@tripsandadventures.co.ug" class="cta-contact-item"><i class="fa-solid fa-envelope"></i> info@tripsandadventures.co.ug</a>
      <a href="https://wa.me/256767936590" target="_blank" rel="noopener" class="cta-contact-item"><i class="fa-brands fa-whatsapp"></i> WhatsApp Us Now</a>
    </div>
  </div>
</section>
