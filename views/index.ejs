<%
  // How wide a destination card renders (masonry: 4 / 2 / 1 columns)
  const DEST_SIZES = '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw';

  // Filter tabs only for categories that actually have a featured tour, so no
  // tab leads to an empty grid. Labels keep the friendlier home-page wording.
  const tabLabels = {
    'Primate Safari': 'Primate Treks',
    'Mountain Climbing': 'Mountain Adventures',
    'Cultural Tour': 'Cultural Tours'
  };
  const featuredCategories = [...new Set(featuredTours.map(t => t.category))];
%>

<!-- ═══════════════ SECTION 1: HERO SLIDER ═══════════════ -->
<h1 class="sr-only">Uganda Safaris &amp; East Africa Tours — Conservation Trips &amp; Adventures</h1>
<div class="hero">
  <section class="hero-slider" id="hero" aria-roledescription="carousel" aria-label="Featured safari destinations">

    <% slides.forEach((slide, i) => { %>
    <div class="hero-slide <%= i === 0 ? 'active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= slides.length %>" aria-hidden="<%= i !== 0 %>">
      <div class="hero-slide-bg"><%- image({ src: slide.bg, alt: '', sizes: '100vw', fill: true, priority: i === 0 ? true : 'low' }) %></div>
      <div class="hero-slide-overlay"></div>
      <div class="hero-slide-content">
        <p class="slide-eyebrow"><%= slide.eyebrow %></p>
        <h2 class="slide-title"><%= slide.title %></h2>
        <p class="slide-sub"><%= slide.sub %></p>
        <div class="slide-ctas">
          <a href="<%= slide.cta ? slide.cta.href : '/tours' %>" class="btn btn-primary btn-lg"><%= slide.cta ? slide.cta.label : 'EXPLORE ALL TOURS' %> <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/contact" class="btn btn-outline btn-lg">PLAN MY SAFARI</a>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- Arrows -->
    <button class="slider-arrow slider-prev" type="button" aria-label="Previous slide">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button class="slider-arrow slider-next" type="button" aria-label="Next slide">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Pause + dots -->
    <div class="slider-controls">
      <button class="slider-pause" type="button" aria-label="Pause slideshow" aria-pressed="false">
        <i class="fa-solid fa-pause"></i>
      </button>
      <div class="slider-dots">
        <% slides.forEach((_, i) => { %>
        <button class="slider-dot <%= i === 0 ? 'active' : '' %>" type="button" aria-label="Go to slide <%= i + 1 %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"></button>
        <% }) %>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <span>Scroll to Explore</span>
      <div class="scroll-chevrons">
        <i class="fa-solid fa-chevron-down"></i>
        <i class="fa-solid fa-chevron-down"></i>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STATS: overlay on desktop, a band under the slider on phones ═══════════════ -->
  <div class="hero-trust-strip">
    <div class="container">
      <div class="trust-strip-inner">
        <div class="trust-stat">
          <span class="stat-number" data-count="15" data-suffix="+">15+</span>
          <span class="stat-label">Years Experience</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="2000" data-suffix="+">2,000+</span>
          <span class="stat-label">Happy Travellers</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="6" data-suffix="">6</span>
          <span class="stat-label">Countries</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="50" data-suffix="+">50+</span>
          <span class="stat-label">Tour Packages</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ SECTION 3: ABOUT INTRO ═══════════════ -->
<section class="section" id="about-intro" style="background: var(--surface);">
  <div class="container">
    <div class="grid-2">

      <!-- Text Left -->
      <div class="reveal-left">
        <div class="section-label">
          <i class="fa-solid fa-leaf"></i> Who We Are
        </div>
        <h2 style="color: var(--dark); margin-bottom: 20px;">Your Prime Tour &amp; Travel Partner in Uganda</h2>
        <p class="body-lg" style="color: var(--text-muted); margin-bottom: 16px;">
          Since 2008, Conservation Trips and Adventures has been creating life-changing safari experiences — with a dedication to excellence, safety, and conservation at our core. As a fully-fledged travel, tourism and conservation management company, we cater for both regional and global clients.
        </p>
        <p style="color: var(--text-muted); margin-bottom: 28px;">
          Uganda • Rwanda • Kenya • Tanzania — East Africa's premier safari &amp; adventure travel company, crafting unforgettable journeys that connect travellers with Africa's most extraordinary wildlife and landscapes.
        </p>
        <div class="about-features">
          <div class="about-feature">
            <div class="about-feature-icon"><i class="fa-solid fa-leaf"></i></div>
            <div>
              <div class="about-feature-title">Conservation-First</div>
              <div class="about-feature-desc">Every trip directly contributes to Uganda's wildlife protection and local community livelihoods.</div>
            </div>
          </div>
          <div class="about-feature">
            <div class="about-feature-icon"><i class="fa-solid fa-globe"></i></div>
            <div>
              <div class="about-feature-title">Regional &amp; Global Clients</div>
              <div class="about-feature-desc">Serving travellers from East Africa and across the world with tailored, premium experiences.</div>
            </div>
          </div>
        </div>
        <a href="/about" class="about-discover-link">
          Discover Our Story <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <!-- Images Right -->
      <div class="reveal-right">
        <div class="about-image-stack">
          <div class="about-img-primary">
            <%- image({ src: '/images/lion.jpg', sizes: '(min-width: 1024px) 30vw, 70vw', className: 'about-photo' }) %>
          </div>
          <div class="about-img-secondary">
            <%- image({ src: '/images/gorilla.jpg', sizes: '(min-width: 1024px) 18vw, 40vw', className: 'about-photo' }) %>
          </div>
          <div class="about-years-badge">
            <span class="badge-num">15+</span>
            <span class="badge-text">Years of<br>Experience</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 4: FEATURED TOURS ═══════════════ -->
<section class="section" id="featured-tours" style="background: var(--surface-alt); position: relative;">
  <!-- Top Wave -->
  <div style="position: absolute; top: -1px; left: 0; right: 0; line-height: 0;">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%;">
      <path d="M0,60 C480,0 960,60 1440,20 L1440,0 L0,0 Z" fill="#FFFFFF"/>
    </svg>
  </div>

  <div class="container">
    <div class="tours-section-header reveal">
      <div>
        <div class="section-label"><i class="fa-solid fa-compass"></i> Safari Packages</div>
        <h2 style="color: var(--dark);">Handpicked Journeys Through Uganda</h2>
        <p class="section-subtitle">Every experience is expertly guided, sustainably operated, and crafted to create memories that last a lifetime.</p>
      </div>
      <a href="/tours" class="btn btn-outline-dark hide-mobile">View All Tours <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-bar reveal mt-32" role="tablist" aria-label="Filter safari packages">
      <button class="filter-tab active" type="button" data-category="All" role="tab" aria-selected="true">All Safaris</button>
      <% featuredCategories.forEach(cat => { %>
      <button class="filter-tab" type="button" data-category="<%= cat %>" role="tab" aria-selected="false"><%= tabLabels[cat] || cat %></button>
      <% }) %>
    </div>

    <!-- Tours Grid -->
    <div class="tours-grid reveal-grid" id="featured-tours-grid">
      <% featuredTours.forEach(tour => { %>
        <%- include('partials/tour-card', { tour }) %>
      <% }) %>
    </div>

    <div class="text-center mt-48 reveal">
      <a href="/tours" class="btn btn-primary btn-lg">View All Safari Packages <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div style="position: absolute; bottom: -1px; left: 0; right: 0; line-height: 0;">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%;">
      <path d="M0,0 C480,60 960,0 1440,40 L1440,60 L0,60 Z" fill="#0F1F0F"/>
    </svg>
  </div>
</section>

<!-- ═══════════════ SECTION 5: DESTINATIONS ═══════════════ -->
<section class="section" id="destinations" style="background: var(--dark);">
  <div class="container-wide">
    <div class="text-center reveal mb-0" style="padding-bottom: 0;">
      <div class="section-label light"><i class="fa-solid fa-map-location-dot"></i> Explore Africa</div>
      <h2 style="color: #fff; font-style: italic;">Uganda's Most Breathtaking Destinations</h2>
      <p style="color: rgba(255,255,255,0.6); max-width: 580px; margin: 12px auto 0; font-size: 1.05rem;">
        From Uganda's mountain gorillas to Tanzania's endless Serengeti plains — we take you to the heart of East Africa's most iconic destinations.
      </p>
    </div>

    <div class="destinations-masonry reveal-grid">
      <!-- Tall card 1 -->
      <div class="dest-card dest-tall">
        <div class="dest-card-bg"><%- image({ src: '/images/gorilla.jpg', alt: '', sizes: DEST_SIZES, fill: true }) %></div>
        <div class="dest-card-overlay"></div>
        <div class="dest-card-content">
          <div class="dest-card-region"><span class="fi fi-ug"></span> UGANDA</div>
          <div class="dest-card-name">Bwindi Impenetrable National Park</div>
          <a href="/destinations/uganda" class="dest-card-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>

      <!-- Tall card 2 -->
      <div class="dest-card dest-tall">
        <div class="dest-card-bg"><%- image({ src: '/images/lion.jpg', alt: '', sizes: DEST_SIZES, fill: true }) %></div>
        <div class="dest-card-overlay"></div>
        <div class="dest-card-content">
          <div class="dest-card-region"><span class="fi fi-ug"></span> UGANDA</div>
          <div class="dest-card-name">Queen Elizabeth National Park</div>
          <a href="/destinations/uganda" class="dest-card-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>

      <!-- Normal cards -->
      <% const normalDests = [
        { name: 'Kibale Forest National Park', region: 'UGANDA', flag: 'fi-ug', img: '/images/safari.jpg', href: '/destinations/uganda' },
        { name: 'Murchison Falls National Park', region: 'UGANDA', flag: 'fi-ug', img: '/images/waterfall.jpg', href: '/destinations/uganda' },
        { name: 'Serengeti — Tanzania', region: 'TANZANIA', flag: 'fi-tz', img: '/images/safari.jpg', href: '/destinations/tanzania' },
        { name: 'Rwanda — Land of Gorillas', region: 'RWANDA', flag: 'fi-rw', img: '/images/gorilla.jpg', href: '/destinations/rwanda' }
      ]; %>
      <% normalDests.forEach(d => { %>
      <div class="dest-card dest-normal">
        <div class="dest-card-bg"><%- image({ src: d.img, alt: '', sizes: DEST_SIZES, fill: true }) %></div>
        <div class="dest-card-overlay"></div>
        <div class="dest-card-content">
          <div class="dest-card-region"><span class="fi <%= d.flag %>"></span> <%= d.region %></div>
          <div class="dest-card-name"><%= d.name %></div>
          <a href="<%= d.href %>" class="dest-card-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="text-center mt-48 reveal">
      <a href="/destinations" class="btn btn-outline btn-lg">View All Destinations <i class="fa-solid fa-globe"></i></a>
    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 5b: THE EQUATOR ═══════════════ -->
<section class="section" id="equator" style="background: var(--surface-alt);">
  <div class="container">
    <div class="grid-2">

      <!-- Photos -->
      <div class="reveal-left">
        <div class="about-image-stack">
          <div class="about-img-primary">
            <%- image({ src: '/images/photos/equator-kikorongo-globe.webp', sizes: '(min-width: 1024px) 30vw, 70vw', fill: true }) %>
          </div>
          <div class="about-img-secondary">
            <%- image({ src: '/images/photos/equator-kayabwe-ring.webp', sizes: '(min-width: 1024px) 18vw, 40vw', fill: true }) %>
          </div>
        </div>
      </div>

      <!-- Text -->
      <div class="reveal-right">
        <div class="section-label"><i class="fa-solid fa-globe"></i> Cross the Equator</div>
        <h2 style="color: var(--dark); margin-bottom: 20px;">Stand on the Equator, One Foot in Each Hemisphere</h2>
        <p class="body-lg" style="color: var(--text-muted); margin-bottom: 16px;">
          The Equator runs straight through Uganda, and it is easy to include on a safari. Two monuments make natural stops on the road to the western parks, and we build the time for photographs into your route.
        </p>
        <div class="about-features">
          <div class="about-feature">
            <div class="about-feature-icon"><i class="fa-solid fa-circle-notch"></i></div>
            <div>
              <div class="about-feature-title">Kayabwe</div>
              <div class="about-feature-desc">The white ring on the Kampala&ndash;Masaka road: the classic stop on the way to Lake Mburo, Lake Bunyonyi and Bwindi.</div>
            </div>
          </div>
          <div class="about-feature">
            <div class="about-feature-icon"><i class="fa-solid fa-earth-africa"></i></div>
            <div>
              <div class="about-feature-title">Kikorongo</div>
              <div class="about-feature-desc">The mirror-steel globe beside Queen Elizabeth National Park, on the road to Kasese, the Rwenzoris and the Kazinga Channel.</div>
            </div>
          </div>
        </div>
        <div class="flex-center gap-16 flex-wrap" style="justify-content:flex-start; margin-top:32px;">
          <a href="/gallery#equator" class="btn btn-green">See the Equator photos <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/contact" class="btn btn-outline-dark">Add it to my safari</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 6: WHY CHOOSE US ═══════════════ -->
<section class="section" id="why-us" style="background: var(--surface);">
  <!-- Top Wave -->
  <div style="margin-top: -1px; line-height: 0;">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%;">
      <path d="M0,60 C360,10 720,50 1080,20 C1260,8 1380,30 1440,60 L1440,0 L0,0 Z" fill="#0F1F0F"/>
    </svg>
  </div>
  <div class="container">
    <div class="text-center reveal mb-48">
      <div class="section-label"><i class="fa-solid fa-star"></i> Why Choose Us</div>
      <h2 style="color: var(--dark);">Safari Excellence, Every Step of the Way</h2>
    </div>

    <div class="why-us-grid">
      <!-- Left Column -->
      <div class="why-us-col reveal-left">
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-paw"></i></div>
          <div>
            <div class="why-us-title">Gorilla Trekking Experts</div>
            <div class="why-us-desc">Specialist gorilla permit procurement, expert guides with decade-long Bwindi experience, and group sizes carefully managed for authentic encounters.</div>
          </div>
        </div>
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-leaf"></i></div>
          <div>
            <div class="why-us-title">Conservation-First Tourism</div>
            <div class="why-us-desc">Every trip we organise contributes directly to Uganda's conservation efforts and local community livelihoods. Travel that gives back.</div>
          </div>
        </div>
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-map"></i></div>
          <div>
            <div class="why-us-title">Custom Itineraries</div>
            <div class="why-us-desc">Your journey, your way. Every safari is tailored to your timeline, travel style, group size, and budget — no two trips are the same.</div>
          </div>
        </div>
      </div>

      <!-- Centre photograph -->
      <div class="why-us-center-img reveal-scale">
        <figure class="why-us-photo">
          <%- image({ src: '/images/gorilla.jpg', sizes: '(min-width: 1024px) 30vw, 90vw' }) %>
          <figcaption>Bwindi Impenetrable Forest</figcaption>
        </figure>
      </div>

      <!-- Right Column -->
      <div class="why-us-col why-us-right reveal-right">
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-truck-monster"></i></div>
          <div>
            <div class="why-us-title">Exclusive Safari Vehicles</div>
            <div class="why-us-desc">Custom 4x4 safari vehicles with pop-up roofs, USB charging, cooler boxes, and first-aid kits — built for comfort and wildlife viewing.</div>
          </div>
        </div>
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-shield-halved"></i></div>
          <div>
            <div class="why-us-title">Licensed &amp; Insured</div>
            <div class="why-us-desc">Fully registered with Uganda Tourism Board and Uganda Wildlife Authority. Your safety is our top priority with rigorous protocols throughout.</div>
          </div>
        </div>
        <div class="why-us-item">
          <div class="why-us-icon-wrap"><i class="fa-solid fa-headset"></i></div>
          <div>
            <div class="why-us-title">24/7 Dedicated Support</div>
            <div class="why-us-desc">Your dedicated trip advisor is available throughout your journey — from first enquiry through to your safe return home.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 7: TESTIMONIALS ═══════════════ -->
<section class="section" id="testimonials" style="background: linear-gradient(135deg, var(--primary-dark) 0%, var(--sky) 100%); padding-top: 80px; padding-bottom: 80px;">
  <div class="container">
    <div class="text-center reveal mb-48">
      <div class="section-label light"><i class="fa-solid fa-star"></i> Testimonials</div>
      <h2 style="color: #fff; font-style: italic;">What Our Travellers Say</h2>
    </div>

    <div class="testimonial-slider reveal" role="region" aria-roledescription="carousel" aria-label="Traveller testimonials">
      <div class="testimonial-track" tabindex="0">
        <% testimonials.forEach(t => { %>
          <%- include('partials/testimonial-card', { testimonial: t }) %>
        <% }) %>
      </div>

      <div class="testimonial-nav">
        <button class="test-arrow test-prev" type="button" aria-label="Previous testimonial"><i class="fa-solid fa-chevron-left"></i></button>
        <div class="test-dots">
          <% testimonials.forEach((_, i) => { %>
          <button class="test-dot <%= i === 0 ? 'active' : '' %>" type="button" aria-label="Testimonial <%= i + 1 %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"></button>
          <% }) %>
        </div>
        <button class="test-arrow test-next" type="button" aria-label="Next testimonial"><i class="fa-solid fa-chevron-right"></i></button>
        <button class="test-pause" type="button" aria-label="Pause testimonials" aria-pressed="false"><i class="fa-solid fa-pause"></i></button>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 8: CONSERVATION ═══════════════ -->
<section class="conservation-section" id="conservation">
  <div class="container">
    <div class="grid-2">
      <div class="reveal-left">
        <div class="section-label light"><i class="fa-solid fa-leaf"></i> Our Commitment</div>
        <h2 style="color: #fff; font-style: italic; margin-bottom: 20px;">Travel That Gives Back</h2>
        <p style="color: rgba(255,255,255,0.8); font-size: 1.05rem; line-height: 1.8; margin-bottom: 32px;">
          Every safari we organise contributes directly to Uganda's conservation efforts. We partner with local communities, employ certified guides, and support the Uganda Wildlife Authority's mission to protect endangered species for generations to come.
        </p>
        <div class="conservation-stats">
          <div class="conservation-stat">
            <div class="stat-number" data-count="1000" data-suffix="+">1,000+</div>
            <div class="stat-label">Gorillas Protected</div>
          </div>
          <div class="conservation-stat">
            <div class="stat-number" data-count="200" data-suffix="+">200+</div>
            <div class="stat-label">Local Jobs Created</div>
          </div>
          <div class="conservation-stat">
            <div class="stat-number" data-count="10" data-suffix="%">10%</div>
            <div class="stat-label">Revenue to Conservation</div>
          </div>
        </div>
        <a href="/about" class="btn btn-outline mt-32">Our Conservation Pledge <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="conservation-img-wrap reveal-right">
        <figure class="conservation-photo">
          <%- image({ src: '/images/safari.jpg', sizes: '(min-width: 1024px) 45vw, 90vw' }) %>
        </figure>
      </div>
    </div>
  </div>
</section>



<!-- ═══════════════ SECTION 9: FROM OUR FEED ═══════════════
     Static cards (no third-party script): photos are served from /images/social and each
     card links out to the original post on X. Data lives in data/social.json. -->
<% const socialPosts = (typeof social !== 'undefined' && social && social.posts) ? social.posts : []; %>
<% if (socialPosts.length) { %>
<section class="section" id="social" style="background: var(--surface-alt);">
  <div class="container">
    <div class="tours-section-header reveal">
      <div>
        <div class="section-label"><i class="fa-brands fa-x-twitter"></i> Follow the Adventure</div>
        <h2 style="color: var(--dark);">Moments From the Field</h2>
        <p class="section-subtitle">Mountains, rivers and wildlife — shared on X as <a href="<%= social.profileUrl %>" target="_blank" rel="noopener" class="text-link">@<%= social.handle %></a>.</p>
      </div>
      <a href="<%= social.profileUrl %>" target="_blank" rel="noopener" class="btn btn-outline-dark hide-mobile">Follow on X <i class="fa-brands fa-x-twitter"></i></a>
    </div>

    <div class="social-grid reveal-grid">
      <% socialPosts.forEach(post => {
           const media = post.media || [];
           // card copy: single line, trailing hashtag block dropped
           const copy = post.text.replace(/\s*\n+\s*/g, ' ').replace(/(\s+#\w+)+\s*$/, '').trim();
           const when = new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      %>
      <article class="social-card">
        <% if (media.length === 1) { %>
        <div class="social-media">
          <%- image({ src: media[0].src, alt: media[0].alt, sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw' }) %>
        </div>
        <% } else if (media.length > 1) { %>
        <div class="social-media social-media--mosaic">
          <% media.slice(0, 3).forEach(m => { %>
          <%- image({ src: m.src, alt: m.alt, sizes: '(min-width: 1024px) 130px, 33vw' }) %>
          <% }) %>
        </div>
        <% } else { %>
        <div class="social-media social-media--text" aria-hidden="true">
          <i class="fa-solid fa-leaf"></i>
          <span><%= post.label || 'From our feed' %></span>
        </div>
        <% } %>
        <div class="social-body">
          <div class="social-meta">
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            <span>@<%= social.handle %></span>
            <span aria-hidden="true">·</span>
            <time datetime="<%= post.date %>"><%= when %></time>
          </div>
          <p class="social-text"><%= copy %></p>
          <a class="social-link" href="<%= post.url %>" target="_blank" rel="noopener">
            View on X <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </article>
      <% }) %>
    </div>

    <div class="text-center mt-32 reveal hide-desktop">
      <a href="<%= social.profileUrl %>" target="_blank" rel="noopener" class="btn btn-outline-dark">Follow on X <i class="fa-brands fa-x-twitter"></i></a>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ SECTION 9b: FROM THE ROAD ═══════════════ -->
<% if (typeof photoStrip !== 'undefined' && photoStrip.length) { %>
<section class="section" id="photos" style="background: var(--surface);">
  <div class="container-wide">
    <div class="tours-section-header reveal">
      <div>
        <div class="section-label"><i class="fa-solid fa-camera"></i> From the Road</div>
        <h2 style="color: var(--dark);">Photographed on Our Own Journeys</h2>
        <p class="section-subtitle">Equator monuments, plains game and golden hours on the Kazinga Channel: every picture here was taken on a Conservation Trips journey.</p>
      </div>
      <a href="/gallery" class="btn btn-outline-dark hide-mobile">See all photos <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="photo-strip reveal-grid">
      <% photoStrip.forEach((p, i) => { %>
      <a class="photo-strip-item<%= i === 0 ? ' photo-strip-item--feature' : '' %>" href="<%= p.href %>">
        <%- image({ src: p.src, alt: '', sizes: i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw', fill: true }) %>
        <span class="photo-strip-caption"><strong><%= p.title %></strong><small><%= p.count %> photos</small></span>
      </a>
      <% }) %>
    </div>

    <div class="text-center mt-32 reveal hide-desktop">
      <a href="/gallery" class="btn btn-outline-dark">See all photos <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ SECTION 10: BLOG PREVIEW ═══════════════ -->
<section class="section" id="blog-preview" style="background: var(--surface);">
  <div class="container">
    <div class="tours-section-header reveal">
      <div>
        <div class="section-label"><i class="fa-solid fa-newspaper"></i> Safari Insights</div>
        <h2 style="color: var(--dark);">Safari Insights &amp; Travel Tips</h2>
      </div>
      <a href="/blog" class="btn btn-outline-dark hide-mobile">View All Articles <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="blog-grid reveal-grid mt-48">

      <% latestPosts.forEach(post => { %>
      <article class="blog-card">
        <a href="/blog/<%= post.slug %>" class="blog-card-img" tabindex="-1" aria-hidden="true">
          <%- image({ src: post.image, alt: '', sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw', position: post.imagePosition }) %>
        </a>
        <div class="blog-card-body">
          <div class="blog-meta">
            <span class="blog-date"><i class="fa-regular fa-calendar"></i> <%= post.date %></span>
            <span class="blog-cat"><%= post.category %></span>
          </div>
          <h3 class="blog-title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
          <p class="blog-excerpt"><%= post.excerpt %></p>
          <div class="blog-footer">
            <span class="blog-read-time"><i class="fa-regular fa-clock"></i> <%= post.readTime %></span>
            <span class="blog-read-more" aria-hidden="true">Read more <i class="fa-solid fa-arrow-right"></i></span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <div class="text-center mt-32 reveal hide-desktop">
      <a href="/blog" class="btn btn-outline-dark">View All Articles <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

