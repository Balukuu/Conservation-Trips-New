        <a href="/contact" class="btn btn-primary btn-lg">Start Planning <i class="fa-solid fa-arrow-right"></i></a>
        <a href="/contact" class="btn btn-outline btn-lg">Contact Us</a>
      </div>
      <div class="cta-contact-row">
        <a href="tel:+256767936590" class="cta-contact-item">
          <i class="fa-solid fa-phone"></i> +256 767 936 590
        </a>
        <a href="mailto:info@tripsandadventures.co.ug" class="cta-contact-item">
          <i class="fa-solid fa-envelope"></i> info@tripsandadventures.co.ug
        </a>
        <a href="https://wa.me/256767936590" target="_blank" rel="noopener" class="cta-contact-item">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp Us
        </a>
