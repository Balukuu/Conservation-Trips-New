<%
  // Filter tabs only for categories that actually have a featured tour, so no
  // tab leads to an empty grid. Labels keep the friendlier home-page wording.
  const tabLabels = {
    'Primate Safari': 'Primate Treks',
    'Mountain Climbing': 'Mountain Adventures',
    'Cultural Tour': 'Cultural Tours'
  };
  const featuredCategories = [...new Set(featuredTours.map(t => t.category))];
%>

<!-- ═══════════════ SECTION 1: HERO SLIDER ═══════════════ -->
<h1 class="sr-only">Uganda Safaris &amp; East Africa Tours — Conservation Trips &amp; Adventures</h1>
<div class="hero">
  <section class="hero-slider" id="hero" aria-roledescription="carousel" aria-label="Featured safari destinations">

    <% slides.forEach((slide, i) => { %>
    <div class="hero-slide <%= i === 0 ? 'active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= slides.length %>" aria-hidden="<%= i !== 0 %>">
      <div class="hero-slide-bg"><%- image({ src: slide.bg, alt: '', sizes: '100vw', fill: true, priority: i === 0 ? true : 'low' }) %></div>
      <div class="hero-slide-overlay"></div>
      <div class="hero-slide-content">
        <p class="slide-eyebrow"><%= slide.eyebrow %></p>
        <h2 class="slide-title"><%= slide.title %></h2>
        <p class="slide-sub"><%= slide.sub %></p>
        <div class="slide-ctas">
          <a href="<%= slide.cta ? slide.cta.href : '/tours' %>" class="btn btn-primary btn-lg"><%= slide.cta ? slide.cta.label : 'EXPLORE ALL TOURS' %> <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/contact" class="btn btn-outline btn-lg">PLAN MY SAFARI</a>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- Arrows -->
    <button class="slider-arrow slider-prev" type="button" aria-label="Previous slide">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button class="slider-arrow slider-next" type="button" aria-label="Next slide">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Pause + dots -->
    <div class="slider-controls">
      <button class="slider-pause" type="button" aria-label="Pause slideshow" aria-pressed="false">
        <i class="fa-solid fa-pause"></i>
      </button>
      <div class="slider-dots">
        <% slides.forEach((_, i) => { %>
        <button class="slider-dot <%= i === 0 ? 'active' : '' %>" type="button" aria-label="Go to slide <%= i + 1 %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"></button>
        <% }) %>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <span>Scroll to Explore</span>
      <div class="scroll-chevrons">
        <i class="fa-solid fa-chevron-down"></i>
        <i class="fa-solid fa-chevron-down"></i>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STATS: overlay on desktop, a band under the slider on phones ═══════════════ -->
  <div class="hero-trust-strip">
    <div class="container">
      <div class="trust-strip-inner">
        <div class="trust-stat">
          <span class="stat-number" data-count="15" data-suffix="+">15+</span>
          <span class="stat-label">Years Experience</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="2000" data-suffix="+">2,000+</span>
          <span class="stat-label">Happy Travellers</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="6" data-suffix="">6</span>
          <span class="stat-label">Countries</span>
        </div>
        <div class="trust-stat">
          <span class="stat-number" data-count="50" data-suffix="+">50+</span>
          <span class="stat-label">Tour Packages</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Everything below the hero. Styles: public/css/home.css (hm-*).
     ═══════════════════════════════════════════════════════════════ -->

<!-- ═══════════════ 1. FIND YOUR KIND OF SAFARI ═══════════════ -->
<section class="hm-section" id="experiences">
  <div class="container-wide">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">What do you want to see?</span>
        <h2>Find your kind of safari</h2>
      </div>
      <a class="hm-link" href="/tours">All safari packages <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <ul class="hm-tiles reveal">
      <% categoryTiles.forEach(t => { %>
      <li>
        <a class="hm-tile" href="<%= t.href %>">
          <%- image({ src: t.image, alt: '', sizes: '(min-width: 1200px) 16vw, (min-width: 640px) 30vw, 60vw', fill: true, position: t.position }) %>
          <span class="hm-tile-icon"><i class="fa-solid <%= t.icon %>" aria-hidden="true"></i></span>
          <span class="hm-tile-body">
            <strong><%= t.label %></strong>
            <small><%= t.count %> <%= t.count === 1 ? 'tour' : 'tours' %></small>
          </span>
        </a>
      </li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- ═══════════════ 2. FEATURED SAFARIS ═══════════════ -->
<section class="hm-section hm-alt" id="featured-tours">
  <div class="container">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">Safari packages</span>
        <h2>Handpicked journeys through Uganda</h2>
        <p>Every experience is expertly guided, sustainably operated, and crafted to create memories that last a lifetime.</p>
      </div>
      <a class="hm-link hide-mobile" href="/tours">View all tours <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="filter-bar hm-filter reveal" role="tablist" aria-label="Filter safari packages">
      <button class="filter-tab active" type="button" data-category="All" role="tab" aria-selected="true">All Safaris</button>
      <% featuredCategories.forEach(cat => { %>
      <button class="filter-tab" type="button" data-category="<%= cat %>" role="tab" aria-selected="false"><%= tabLabels[cat] || cat %></button>
      <% }) %>
    </div>

    <div class="tours-grid reveal-grid" id="featured-tours-grid">
      <% featuredTours.forEach(tour => { %>
        <%- include('partials/tour-card', { tour }) %>
      <% }) %>
    </div>

    <div class="text-center mt-48 reveal hide-desktop">
      <a href="/tours" class="btn btn-primary">View all safari packages <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ═══════════════ 3. WHY CONSERVATION TRIPS ═══════════════ -->
<section class="hm-section" id="why-us">
  <div class="container">
    <div class="hm-split">
      <div class="hm-collage reveal-left">
        <div class="hm-collage-main">
          <%- image({ src: '/images/photos/coaster-guides.webp', sizes: '(min-width: 1024px) 40vw, 90vw', fill: true }) %>
        </div>
        <div class="hm-collage-sub">
          <%- image({ src: '/images/photos/equator-kayabwe-staff-ring.webp', sizes: '(min-width: 1024px) 18vw, 40vw', fill: true }) %>
        </div>
        <div class="hm-badge">
          <strong>Since 2008</strong>
          <span>Crafting journeys across East Africa</span>
        </div>
      </div>

      <div class="reveal-right">
        <span class="hm-eyebrow">Why Conservation Trips</span>
        <h2>Your prime tour &amp; travel partner in Uganda</h2>
        <p class="hm-lead">
          We are a fully-fledged travel, tourism and conservation management company, proudly local and deeply knowledgeable, serving both regional and global clients with a dedication to excellence, safety and conservation.
        </p>

        <ul class="hm-features">
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-paw" aria-hidden="true"></i></span>
            <div><h3>Gorilla trekking experts</h3><p>Specialist permit procurement, guides with decade-long Bwindi experience, and group sizes managed for authentic encounters.</p></div>
          </li>
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
            <div><h3>Conservation-first</h3><p>Every trip contributes directly to Uganda's conservation efforts and local community livelihoods. Travel that gives back.</p></div>
          </li>
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-map" aria-hidden="true"></i></span>
            <div><h3>Custom itineraries</h3><p>Tailored to your timeline, travel style, group size and budget. No two trips are the same.</p></div>
          </li>
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-truck-monster" aria-hidden="true"></i></span>
            <div><h3>Safari vehicles built for it</h3><p>4x4s with pop-up roofs, USB charging, cooler boxes and first-aid kits, made for comfort and wildlife viewing.</p></div>
          </li>
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
            <div><h3>Licensed &amp; insured</h3><p>Registered with Uganda Tourism Board and Uganda Wildlife Authority, with rigorous safety protocols throughout.</p></div>
          </li>
          <li>
            <span class="hm-feature-icon"><i class="fa-solid fa-headset" aria-hidden="true"></i></span>
            <div><h3>24/7 support</h3><p>A dedicated trip advisor is available from your first enquiry through to your safe return home.</p></div>
          </li>
        </ul>

        <a class="hm-link" href="/about">Discover our story <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 4. DESTINATIONS ═══════════════ -->
<section class="hm-section hm-dark" id="destinations">
  <div class="container-wide">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">Explore East Africa</span>
        <h2>Where we take you</h2>
        <p>From Uganda's mountain gorillas to Tanzania's endless Serengeti plains, we take you to the heart of East Africa's most iconic destinations.</p>
      </div>
      <a class="hm-link" href="/destinations">All destinations <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="hm-countries reveal-grid">
      <% countries.forEach((c, i) => { %>
      <a class="hm-country<%= i === 0 ? ' hm-country--lead' : '' %>" href="/destinations/<%= c.slug %>">
        <%- image({ src: c.image, alt: '', sizes: i === 0 ? '(min-width: 1024px) 45vw, 100vw' : '(min-width: 1024px) 28vw, 100vw', fill: true }) %>
        <span class="hm-country-body">
          <small><%= c.subtitle %></small>
          <strong><%= c.name %></strong>
          <% if (i === 0) { %>
          <span class="hm-chips">
            <% ugandaParks.forEach(p => { %><span><%= p.name.replace(/ (Impenetrable )?(Forest )?National Park$/, '').replace(/ Valley$/, '') %></span><% }) %>
          </span>
          <% } %>
          <span class="hm-country-meta"><%= c.tourCount %> <%= c.tourCount === 1 ? 'tour' : 'tours' %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ 5. FROM OUR OWN JOURNEYS (photo bento) ═══════════════ -->
<section class="hm-section" id="moments">
  <div class="container-wide">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">Photographed on our own journeys</span>
        <h2>Stand on the Equator, meet the plains</h2>
        <p>The Equator runs straight through Uganda and is an easy stop on the road to the western parks. Here are a few frames from the road.</p>
      </div>
      <a class="hm-link" href="/gallery">Open the gallery <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="hm-bento reveal-grid">
      <% moments.forEach(m => { %>
      <a class="hm-bento-item hm-bento-item--<%= m.shape %>" href="<%= m.href %>">
        <%- image({ src: m.src, alt: '', sizes: m.shape === 'feature' || m.shape === 'wide' ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw', fill: true }) %>
        <span class="hm-bento-caption"><%= m.caption %></span>
      </a>
      <% }) %>
      <a class="hm-bento-cta" href="/gallery">
        <strong><%= photoTotal %></strong>
        <span>photographs from our own trips, in albums</span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════ 6. HOW IT WORKS ═══════════════ -->
<section class="hm-section hm-alt" id="how-it-works">
  <div class="container">
    <header class="hm-head hm-head--center reveal">
      <div>
        <span class="hm-eyebrow">Planning your safari</span>
        <h2>From first enquiry to safe return</h2>
      </div>
    </header>

    <ol class="hm-steps reveal-grid">
      <li class="hm-step">
        <span class="hm-step-num" aria-hidden="true">1</span>
        <span class="hm-step-icon"><i class="fa-solid fa-comments" aria-hidden="true"></i></span>
        <h3>Tell us your dream</h3>
        <p>Send an enquiry in three quick steps: what you'd like to see, when, and who is travelling. No payment is needed at this stage.</p>
      </li>
      <li class="hm-step">
        <span class="hm-step-num" aria-hidden="true">2</span>
        <span class="hm-step-icon"><i class="fa-solid fa-route" aria-hidden="true"></i></span>
        <h3>Get a personalised itinerary</h3>
        <p>We reply within 24 hours with an itinerary and quote shaped around your dates, interests and budget.</p>
      </li>
      <li class="hm-step">
        <span class="hm-step-num" aria-hidden="true">3</span>
        <span class="hm-step-icon"><i class="fa-solid fa-suitcase-rolling" aria-hidden="true"></i></span>
        <h3>We handle the details</h3>
        <p>Permits, vehicles, lodges and guides are arranged for you, and your trip advisor is on hand until you are safely home.</p>
      </li>
    </ol>

    <div class="text-center mt-48 reveal">
      <a href="/contact" class="btn btn-primary btn-lg">Start your enquiry <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ═══════════════ 7. TRAVELLER REVIEWS ═══════════════ -->
<section class="hm-section" id="testimonials">
  <div class="container">
    <div class="hm-reviews">
      <div class="hm-reviews-intro reveal-left">
        <span class="hm-eyebrow">Traveller reviews</span>
        <h2>What our travellers say</h2>
        <% if (rating.count) { %>
        <div class="hm-rating">
          <span class="hm-rating-score"><%= rating.average.toFixed(1) %></span>
          <span class="hm-rating-detail">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <small>average from <%= rating.count %> traveller reviews</small>
          </span>
        </div>
        <% } %>
      </div>

      <div class="testimonial-slider reveal-right" role="region" aria-roledescription="carousel" aria-label="Traveller testimonials">
        <div class="testimonial-track" tabindex="0">
          <% testimonials.forEach(t => { %>
            <%- include('partials/testimonial-card', { testimonial: t }) %>
          <% }) %>
        </div>

        <div class="testimonial-nav">
          <button class="test-arrow test-prev" type="button" aria-label="Previous testimonial"><i class="fa-solid fa-chevron-left"></i></button>
          <div class="test-dots">
            <% testimonials.forEach((_, i) => { %>
            <button class="test-dot <%= i === 0 ? 'active' : '' %>" type="button" aria-label="Testimonial <%= i + 1 %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"></button>
            <% }) %>
          </div>
          <button class="test-arrow test-next" type="button" aria-label="Next testimonial"><i class="fa-solid fa-chevron-right"></i></button>
          <button class="test-pause" type="button" aria-label="Pause testimonials" aria-pressed="false"><i class="fa-solid fa-pause"></i></button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ 8. CONSERVATION ═══════════════ -->
<section class="hm-conservation" id="conservation">
  <div class="container">
    <div class="hm-conservation-grid">
      <div class="reveal-left">
        <span class="hm-eyebrow">Our commitment</span>
        <h2>Travel that gives back</h2>
        <p>Every safari we organise contributes directly to Uganda's conservation efforts. We partner with local communities, employ certified guides, and support the Uganda Wildlife Authority's mission to protect endangered species for generations to come.</p>

        <dl class="hm-stats">
          <div>
            <dt>Gorillas protected</dt>
            <dd class="stat-number" data-count="1000" data-suffix="+">1,000+</dd>
          </div>
          <div>
            <dt>Local jobs created</dt>
            <dd class="stat-number" data-count="200" data-suffix="+">200+</dd>
          </div>
          <div>
            <dt>Revenue to conservation</dt>
            <dd class="stat-number" data-count="10" data-suffix="%">10%</dd>
          </div>
        </dl>

        <a href="/about" class="btn btn-outline">Our conservation pledge <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <figure class="hm-conservation-photo reveal-right">
        <%- image({ src: '/images/safari.jpg', sizes: '(min-width: 1024px) 40vw, 90vw', fill: true }) %>
      </figure>
    </div>
  </div>
</section>

<!-- ═══════════════ 9. FROM THE BLOG ═══════════════ -->
<section class="hm-section" id="blog-preview">
  <div class="container">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">Safari insights</span>
        <h2>Guides &amp; travel tips</h2>
      </div>
      <a class="hm-link" href="/blog">All articles <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="hm-posts reveal-grid">
      <% latestPosts.forEach((post, i) => { %>
      <article class="hm-post<%= i === 0 ? ' hm-post--lead' : '' %>">
        <div class="hm-post-img">
          <%- image({ src: post.image, alt: '', sizes: i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 18vw, 40vw', fill: true }) %>
        </div>
        <div class="hm-post-body">
          <div class="hm-post-meta"><span class="hm-post-cat"><%= post.category %></span><span><%= post.readTime %></span></div>
          <h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
          <p><%= post.excerpt %></p>
          <time><%= post.date %></time>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 9: FROM OUR FEED ═══════════════
     Static cards (no third-party script): photos are served from /images/social and each
     card links out to the original post on X. Data lives in data/social.json. -->
<% const socialPosts = (typeof social !== 'undefined' && social && social.posts) ? social.posts : []; %>
<% if (socialPosts.length) { %>
<section class="hm-section hm-alt" id="social">
  <div class="container">
    <header class="hm-head reveal">
      <div>
        <span class="hm-eyebrow">Follow the adventure</span>
        <h2>Moments from the field</h2>
        <p>Mountains, rivers and wildlife, shared on X as <a href="<%= social.profileUrl %>" target="_blank" rel="noopener" class="text-link">@<%= social.handle %></a>.</p>
      </div>
      <a class="hm-link hide-mobile" href="<%= social.profileUrl %>" target="_blank" rel="noopener">Follow on X <i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
    </header>

    <div class="social-grid reveal-grid">
      <% socialPosts.forEach(post => {
           const media = post.media || [];
           // card copy: single line, trailing hashtag block dropped
           const copy = post.text.replace(/\s*\n+\s*/g, ' ').replace(/(\s+#\w+)+\s*$/, '').trim();
           const when = new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      %>
      <article class="social-card">
        <% if (media.length === 1) { %>
        <div class="social-media">
          <%- image({ src: media[0].src, alt: media[0].alt, sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw' }) %>
        </div>
        <% } else if (media.length > 1) { %>
        <div class="social-media social-media--mosaic">
          <% media.slice(0, 3).forEach(m => { %>
          <%- image({ src: m.src, alt: m.alt, sizes: '(min-width: 1024px) 130px, 33vw' }) %>
          <% }) %>
        </div>
        <% } else { %>
        <div class="social-media social-media--text" aria-hidden="true">
          <i class="fa-solid fa-leaf"></i>
          <span><%= post.label || 'From our feed' %></span>
        </div>
        <% } %>
        <div class="social-body">
          <div class="social-meta">
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            <span>@<%= social.handle %></span>
            <span aria-hidden="true">·</span>
            <time datetime="<%= post.date %>"><%= when %></time>
          </div>
          <p class="social-text"><%= copy %></p>
          <a class="social-link" href="<%= post.url %>" target="_blank" rel="noopener">
            View on X <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </article>
      <% }) %>
    </div>

    <div class="text-center mt-32 reveal hide-desktop">
      <a href="<%= social.profileUrl %>" target="_blank" rel="noopener" class="btn btn-outline-dark">Follow on X <i class="fa-brands fa-x-twitter"></i></a>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ 11. FINAL CALL TO ACTION ═══════════════ -->
<section class="hm-cta" id="cta">
  <div class="container">
    <div class="hm-cta-card reveal">
      <div>
        <h2>Let us craft your perfect Uganda safari</h2>
        <p>Take advantage of our trip advisory services and let us help you create a seamless, unforgettable journey through Uganda's captivating landscapes and incredible wildlife encounters.</p>
        <div class="flex-center gap-16 flex-wrap" style="justify-content:flex-start;">
          <a href="/contact" class="btn btn-primary btn-lg">Start planning <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/tours" class="btn btn-outline btn-lg">Browse tours</a>
        </div>
      </div>
      <ul class="hm-cta-contacts">
        <li><a href="tel:+256767936590"><i class="fa-solid fa-phone" aria-hidden="true"></i><span><small>Call us</small>+256 767 936 590</span></a></li>
        <li><a href="https://wa.me/256767936590" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span><small>WhatsApp</small>Chat with a trip advisor</span></a></li>
        <li><a href="mailto:info@tripsandadventures.co.ug"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span><small>Email</small>info@tripsandadventures.co.ug</span></a></li>
      </ul>
    </div>
  </div>
</section>

<!-- Cookie Banner -->
<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie notice">
  <p>We use cookies to improve your browsing experience. <a href="/privacy">Learn more</a></p>
  <button class="btn btn-primary btn-sm cookie-accept" type="button">Accept</button>
</div>

<!-- Availability Toast -->
<div class="availability-toast" id="avail-toast" role="status">
  <i class="fa-solid fa-ticket toast-icon" aria-hidden="true"></i>
