<!-- ═══════════════ SECTION 9: PARTNER LOGOS ═══════════════ -->
<section class="section-sm" id="partners" style="background: var(--surface-alt);">
  <div class="container">
    <div class="text-center reveal mb-32">
      <div class="section-label"><i class="fa-solid fa-handshake"></i> Trusted Partners &amp; Associations</div>
    </div>
    <div class="partners-track-wrap reveal">
      <div class="partners-track">
        <% 
        const partners = [
          { name: 'Uganda Tourism Board', icon: 'fa-landmark' },
          { name: 'Uganda Wildlife Authority', icon: 'fa-shield-dog' },
          { name: 'AUTO', icon: 'fa-car-side' },
          { name: 'IUCN Conservation', icon: 'fa-leaf' },
          { name: 'East Africa Tourism', icon: 'fa-globe' },
          { name: 'TripAdvisor Certified', icon: 'fa-star' },
          { name: 'SafariBookings.com', icon: 'fa-binoculars' }
        ];
        // Duplicate for infinite scroll effect
        [...partners, ...partners].forEach(p => { %>
        <div class="partner-logo-card">
          <i class="fa-solid <%= p.icon %>" style="color: var(--primary); font-size: 1.2rem; margin-right: 12px; opacity: 0.6;"></i>
          <span class="partner-name"><%= p.name %></span>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ SECTION 10: BLOG PREVIEW ═══════════════ -->
<section class="section" id="blog-preview" style="background: var(--surface);">
  <div class="container">
    <div class="tours-section-header reveal">
      <div>
        <div class="section-label"><i class="fa-solid fa-newspaper"></i> Safari Insights</div>
        <h2 style="color: var(--dark);">Safari Insights &amp; Travel Tips</h2>
      </div>
      <a href="/blog" class="btn btn-outline-dark hide-mobile">View All Articles <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="blog-grid reveal-grid mt-48">
      <% const blogPreviews = [
        {
          title: 'The Best Time to Go Gorilla Trekking in Uganda',
          category: 'Gorilla Trekking',
          date: 'March 15, 2025',
          readTime: '6 min read',
          excerpt: 'Planning a gorilla trek in Bwindi? Timing is everything. We break down the dry and wet seasons to help you plan the perfect visit.',
          image: '/images/gorilla.png',
          slug: 'best-time-gorilla-trekking-uganda'
        },
        {
          title: "Uganda's Incredible Tree-Climbing Lions of Ishasha",
          category: 'Wildlife',
          date: 'January 10, 2025',
          readTime: '5 min read',
          excerpt: "One of Africa's most extraordinary wildlife sightings — lions lounging in fig trees. We explore the Ishasha sector of Queen Elizabeth National Park.",
          image: '/images/lion.png',
          slug: 'tree-climbing-lions-ishasha'
        },
        {
          title: 'The Ultimate Uganda Safari Packing List',
          category: 'Travel Tips',
          date: 'February 22, 2025',
          readTime: '8 min read',
          excerpt: 'From gorilla trekking clothes to savannah game drive essentials — everything you need to pack for the perfect Uganda safari.',
          image: '/images/lion.png',
          slug: 'uganda-packing-list-safari'
        }
      ]; %>

      <% blogPreviews.forEach(post => { %>
      <article class="blog-card">
        <a href="/blog/<%= post.slug %>" class="blog-card-img">
          <img src="<%= post.image %>" alt="<%= post.title %>" loading="lazy" onerror="this.src='/images/lion.png'">
        </a>
        <div class="blog-card-body">
          <div class="blog-meta">
            <span class="blog-date"><i class="fa-regular fa-calendar"></i> <%= post.date %></span>
            <span class="blog-cat"><%= post.category %></span>
          </div>
          <h3 class="blog-title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3>
          <p class="blog-excerpt"><%= post.excerpt %></p>
          <div class="blog-footer">
            <span class="blog-read-time"><i class="fa-regular fa-clock"></i> <%= post.readTime %></span>
            <a href="/blog/<%= post.slug %>" class="blog-read-more">Read More <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <div class="text-center mt-32 reveal hide-desktop">
      <a href="/blog" class="btn btn-outline-dark">View All Articles <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

