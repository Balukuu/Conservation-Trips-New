<%
  const plural = (n, one, many) => n + ' ' + (n === 1 ? one : many);
%>
<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero">
  <div class="page-hero-bg"><%- image({ src: '/images/photos/equator-kikorongo-wide.webp', alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>Gallery</span></nav>
    <h1>Safari Gallery</h1>
    <p class="sx-hero-sub"><%= photoTotal %> photographs from our own journeys: the Equator, the plains and the rivers of Uganda.</p>
    <ul class="sx-chips">
      <li><i class="fa-regular fa-images" aria-hidden="true"></i> <%= plural(photoTotal, 'photo', 'photos') %></li>
      <li><i class="fa-solid fa-folder-open" aria-hidden="true"></i> <%= plural(albums.length, 'album', 'albums') %></li>
    </ul>
  </div>
</section>

<!-- ═══════════════ FEATURED PHOTOS ═══════════════ -->
<section class="sx" id="photos">
  <div class="container">

    <!-- Jump links -->
    <nav class="filter-tabs sx-tabs reveal gl-jump" aria-label="Gallery sections">
      <a href="#albums" class="filter-tab filter-tab--strong"><span>All albums</span><span class="sx-tab-count" aria-hidden="true"><%= photoTotal %></span></a>
      <% sections.forEach(section => { %>
      <a href="#<%= section.id %>" class="filter-tab"><span><%= section.title %></span><span class="sx-tab-count" aria-hidden="true"><%= section.items.length %></span></a>
      <% }) %>
    </nav>

    <% sections.forEach(section => { %>
    <div class="gallery-section" id="<%= section.id %>">
      <header class="sx-head reveal">
        <div>
          <span class="sx-eyebrow"><i class="fa-solid <%= section.icon %>" aria-hidden="true"></i> <%= plural(section.items.length, 'photo', 'photos') %></span>
          <h2><%= section.title %></h2>
          <p><%= section.blurb %></p>
        </div>
      </header>

      <div class="gallery-grid gallery-grid--page">
        <% section.items.forEach(item => {
             const info = imageInfo(item.src);
             const tall = info && info.height > info.width * 1.1;
             const cls = ['gallery-item', item.wide ? 'gallery-item--wide' : '', tall ? 'gallery-item--tall' : ''].join(' ').trim();
        %>
        <div class="<%= cls %>">
          <%- image({ src: item.src, sizes: item.wide ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', fill: true }) %>
          <span class="gallery-caption"><%= item.caption %></span>
        </div>
        <% }) %>
      </div>
    </div>
    <% }) %>

  </div>
</section>

<!-- ═══════════════ ALL ALBUMS ═══════════════ -->
<section class="sx sx--alt" id="albums">
  <div class="container">
    <header class="sx-head sx-head--center reveal">
      <div>
        <span class="sx-eyebrow">Every photo</span>
        <h2>Browse the albums</h2>
        <p><%= photoTotal %> photographs from our own journeys, in <%= albums.length %> albums. Open one for the full set.</p>
      </div>
    </header>

    <div class="album-grid reveal-grid">
      <% albums.forEach(a => { %>
      <article class="album-card">
        <div class="album-card-img">
          <%- image({ src: a.cover, alt: '', sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw', fill: true }) %>
          <span class="album-card-count"><i class="fa-regular fa-images" aria-hidden="true"></i> <%= a.count %></span>
        </div>
        <div class="album-card-body">
          <h3 class="album-card-title"><a href="<%= a.href %>"><%= a.title %></a></h3>
          <p class="album-card-blurb"><%= a.blurb %></p>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: 'plain',
  title: 'See it for yourself',
  text: 'Tell us what you would like to see (zebras at Lake Mburo, hippos on the Kazinga Channel, a foot on each side of the Equator) and we will plan the route.',
  primary: { href: '/contact', label: 'Plan my safari' },
  secondary: { href: '/tours', label: 'Browse tours' }
}) %>
