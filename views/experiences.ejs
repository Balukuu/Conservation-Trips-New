<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero ex-hero">
  <div class="page-hero-bg"><%- image({ src: '/images/gorilla.jpg', alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>Experiences</span></nav>
    <h1>Safari Experiences</h1>
    <p class="sx-hero-sub">Every experience is expertly guided, sustainably operated, and crafted to create memories that last a lifetime.</p>
    <ul class="sx-chips ex-jump" aria-label="Jump to an experience">
      <% experiences.forEach(exp => { %>
      <li><a href="#<%= exp.id %>"><i class="fa-solid <%= exp.icon %>" aria-hidden="true"></i> <%= exp.title %></a></li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- ═══════════════ THE EXPERIENCES ═══════════════ -->
<% experiences.forEach((exp, i) => { %>
<section class="sx<%= i % 2 ? ' sx--alt' : '' %> ex-section" id="<%= exp.id %>">
  <div class="container">
    <div class="ex-item<%= i % 2 ? ' ex-item--flip' : '' %>">

      <div class="ex-copy <%= i % 2 ? 'reveal-right' : 'reveal-left' %>">
        <span class="sx-eyebrow"><i class="fa-solid <%= exp.icon %>" aria-hidden="true"></i> Experience <%= String(i + 1).padStart(2, '0') %></span>
        <h2><%= exp.title %></h2>
        <p class="ex-where"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= exp.subtitle %></p>
        <p class="ex-prose"><%= exp.desc1 %></p>
        <p class="ex-prose"><%= exp.desc2 %></p>
        <ul class="ex-list">
          <% exp.highlights.forEach(h => { %>
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span><%= h %></span></li>
          <% }) %>
        </ul>
        <div class="ex-actions">
          <a href="<%= exp.link %>" class="btn btn-green"><%= exp.cta %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <% if (exp.tourCount) { %><span class="ex-count"><%= exp.tourCount %> <%= exp.tourCount === 1 ? 'tour' : 'tours' %> to choose from</span><% } %>
        </div>
      </div>

      <div class="ex-media <%= i % 2 ? 'reveal-left' : 'reveal-right' %>">
        <div class="ex-photo">
          <%- image({ src: exp.image, alt: exp.title, sizes: '(min-width: 1024px) 45vw, 100vw', fill: true, position: exp.imagePosition }) %>
        </div>
        <span class="ex-num" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %></span>
      </div>

    </div>
  </div>
</section>
<% }) %>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: experiences.length % 2 ? 'alt' : 'plain',
  title: 'Find your perfect experience',
  text: 'Tell us what excites you most and our team will craft your dream safari: gorillas, mountains, culture, or all three.',
  primary: { href: '/contact', label: 'Plan my safari' },
  secondary: { href: '/tours', label: 'Browse all tours' }
}) %>
