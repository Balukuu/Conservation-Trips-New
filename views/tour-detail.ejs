<%
  // The hero already shows tour.image, so the photo sections pick up after it.
  const photos = (gallery || []).filter(src => src !== tour.image);
  const mosaic = photos.length >= 3 ? photos.slice(0, 5) : [];
  const morePhotos = photos.slice(mosaic.length);
  const countries = (tour.countries || []).join(' & ');
  const itinerary = tour.itinerary || [];
  const whatsapp = 'https://wa.me/256767936590?text=' + encodeURIComponent('Hello! I\'m interested in "' + tour.name + '". Can you help me plan it?');
%>
<!-- Hero -->
<section class="td-hero">
  <div class="td-hero-img"><%- image({ src: tour.image, alt: '', sizes: '100vw', priority: true, fill: true, position: tour.imagePosition }) %></div>
  <div class="td-hero-shade"></div>
  <div class="td-hero-inner container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
      <a href="/tours">Tours</a>
      <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
      <span><%= tour.name %></span>
    </nav>
    <div class="td-hero-tags">
      <span class="badge badge-accent"><%= tour.category %></span>
      <span class="badge badge-glass"><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= tour.duration %></span>
      <% if (countries) { %><span class="badge badge-glass"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= countries %></span><% } %>
    </div>
    <h1 class="td-title"><%= tour.name %></h1>
  </div>
</section>

<!-- Content -->
<section class="td-content">
  <div class="container">

    <!-- Quick facts -->
    <div class="td-facts">
      <ul class="td-facts-list">
        <li><i class="fa-regular fa-clock" aria-hidden="true"></i><span class="td-fact-label">Duration</span><strong><%= tour.duration %></strong></li>
        <li><i class="fa-solid fa-compass" aria-hidden="true"></i><span class="td-fact-label">Style</span><strong><%= tour.category %></strong></li>
        <% if (countries) { %><li><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span class="td-fact-label">Where</span><strong><%= countries %></strong></li><% } %>
        <li><i class="fa-solid fa-users" aria-hidden="true"></i><span class="td-fact-label">Group</span><strong>Small groups</strong></li>
      </ul>
      <a href="#enquire-form" class="btn btn-primary">Enquire now <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>

    <div class="td-layout">

      <!-- Main column -->
      <div class="td-main">

        <section class="td-section reveal" aria-labelledby="td-overview-h">
          <h2 class="td-h2" id="td-overview-h"><span class="td-h2-icon"><i class="fa-solid fa-binoculars" aria-hidden="true"></i></span>Overview</h2>
          <p class="td-overview"><%= tour.summary %></p>
          <% if (tour.highlights && tour.highlights.length) { %>
          <h3 class="td-h3">Tour highlights</h3>
          <ul class="td-highlights">
            <% tour.highlights.forEach(h => { %>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span><%= h %></span></li>
            <% }) %>
          </ul>
          <% } %>
        </section>

        <% if (mosaic.length) { %>
        <section class="td-section reveal" aria-labelledby="td-photos-h">
          <h2 class="td-h2" id="td-photos-h"><span class="td-h2-icon"><i class="fa-regular fa-images" aria-hidden="true"></i></span>A glimpse of the journey</h2>
          <div class="td-mosaic" data-tiles="<%= mosaic.length %>">
            <% mosaic.forEach((src, i) => { %>
            <div class="gallery-item td-mosaic-item">
              <%- image({ src, sizes: i === 0 ? '(min-width: 1024px) 480px, 100vw' : '(min-width: 1024px) 240px, 50vw', fill: true }) %>
              <% if (i === mosaic.length - 1 && morePhotos.length) { %>
              <span class="td-mosaic-more"><i class="fa-regular fa-images" aria-hidden="true"></i> +<%= morePhotos.length %> more</span>
              <% } %>
            </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% if (itinerary.length) { %>
        <section class="td-section reveal" aria-labelledby="td-itinerary-h">
          <h2 class="td-h2" id="td-itinerary-h"><span class="td-h2-icon"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span>Day-by-day itinerary</h2>
          <div class="accordion td-timeline">
            <% itinerary.forEach((day, i) => { %>
            <div class="accordion-item">
              <button type="button" class="accordion-header" id="day-h-<%= i %>" aria-expanded="<%= i === 0 %>" aria-controls="day-b-<%= i %>">
                <span class="accordion-day"><small>Day</small><b><%= day.day %></b></span>
                <span class="accordion-title"><%= day.title %></span>
                <i class="fa-solid fa-chevron-down accordion-icon" aria-hidden="true"></i>
              </button>
              <div class="accordion-body <%= i === 0 ? 'open' : '' %>" id="day-b-<%= i %>" role="region" aria-labelledby="day-h-<%= i %>">
                <div class="accordion-inner">
                  <p><%= day.description %></p>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <section class="td-section reveal" aria-labelledby="td-included-h">
          <h2 class="td-h2" id="td-included-h"><span class="td-h2-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>What&rsquo;s included</h2>
          <div class="td-inclusions">
            <div class="td-inclusion td-inclusion--yes">
              <h3><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Included</h3>
              <ul>
                <% (tour.included || []).forEach(item => { %>
                <li><i class="fa-solid fa-check" aria-hidden="true"></i><span><%= item %></span></li>
                <% }) %>
              </ul>
            </div>
            <div class="td-inclusion td-inclusion--no">
              <h3><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> Not included</h3>
              <ul>
                <% (tour.excluded || []).forEach(item => { %>
                <li><i class="fa-solid fa-xmark" aria-hidden="true"></i><span><%= item %></span></li>
                <% }) %>
              </ul>
            </div>
          </div>
        </section>

        <section class="td-assure reveal" aria-labelledby="td-assure-h">
          <div class="td-assure-copy">
            <h2 class="td-assure-title" id="td-assure-h">Prefer to talk it through?</h2>
            <p>Message us and a planner will tailor this itinerary to your dates, group and budget.</p>
            <a href="<%= whatsapp %>" target="_blank" rel="noopener" class="td-assure-wa"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Chat with us on WhatsApp</a>
          </div>
          <ul class="td-trust">
            <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> UTB licensed operator</li>
            <li><i class="fa-solid fa-leaf" aria-hidden="true"></i> Conservation-first tourism</li>
            <li><i class="fa-solid fa-headset" aria-hidden="true"></i> 24/7 trip support</li>
          </ul>
        </section>

        <% if (morePhotos.length) { %>
        <section class="td-section reveal" aria-labelledby="td-more-h">
          <h2 class="td-h2" id="td-more-h"><span class="td-h2-icon"><i class="fa-regular fa-image" aria-hidden="true"></i></span>More photos</h2>
          <div class="td-photo-grid">
            <% morePhotos.forEach(src => { %>
            <div class="gallery-item">
              <%- image({ src, sizes: '(min-width: 1024px) 220px, (min-width: 640px) 30vw, 50vw', fill: true }) %>
            </div>
            <% }) %>
          </div>
          <% if (galleryAlbums.length) { %>
          <p class="gallery-more">
            Photos from our own journeys on this route:
            <% galleryAlbums.forEach((a, i) => { %><a href="/gallery/<%= a.slug %>"><%= a.title %> (<%= a.count %>)</a><%= i < galleryAlbums.length - 1 ? ' · ' : '' %><% }) %>
          </p>
          <% } %>
        </section>
        <% } %>

        <div class="td-share reveal">
          <p class="td-share-title">Share this tour</p>
          <div class="share-buttons">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(siteUrl + meta.path) %>" target="_blank" rel="noopener" class="share-btn share-fb"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook</a>
            <a href="https://wa.me/?text=<%= encodeURIComponent(tour.name + ' — Conservation Trips & Adventures: ' + siteUrl + meta.path) %>" target="_blank" rel="noopener" class="share-btn share-wa"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp</a>
            <a href="mailto:?subject=<%= encodeURIComponent(tour.name) %>&amp;body=<%= encodeURIComponent('Check out this safari: ' + siteUrl + meta.path) %>" class="share-btn share-email"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="td-sidebar" aria-label="Enquire about this tour">
        <div class="td-book" id="enquire-form">
          <div class="td-book-head">
            <p class="td-book-meta">
              <span><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= tour.duration %></span>
              <span><i class="fa-solid fa-users" aria-hidden="true"></i> Small groups</span>
            </p>
            <p class="td-book-title">Plan this safari</p>
            <p class="td-book-sub">Tell us your dates and group size</p>
          </div>
          <div class="td-book-body">
            <p class="td-book-note"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> We respond within 24 hours &middot; No payment required</p>
            <%# Same delivery contract as the contact form (see booking.js): the Express
                route in dev, a hosted endpoint if configured, otherwise a prefilled mailto:. %>
            <form id="quick-enquiry-form" novalidate
                  data-mode="<%= typeof staticBuild !== 'undefined' && staticBuild ? 'static' : 'server' %>"
                  data-endpoint="<%= typeof formEndpoint !== 'undefined' ? formEndpoint : '' %>"
                  data-email="info@tripsandadventures.co.ug">
              <input type="hidden" name="tour" value="<%= tour.name %>">
              <div class="form-group">
                <label for="eq-name">Full Name *</label>
                <input type="text" id="eq-name" name="name" class="form-control" placeholder="Your name" autocomplete="name" autocapitalize="words" required>
                <div class="form-error"></div>
              </div>
              <div class="form-group">
                <label for="eq-email">Email *</label>
                <input type="email" id="eq-email" name="email" class="form-control" placeholder="your@email.com" autocomplete="email" autocapitalize="none" spellcheck="false" required>
                <div class="form-error"></div>
              </div>
              <div class="form-group">
                <label for="eq-phone">Phone / WhatsApp</label>
                <input type="tel" id="eq-phone" name="phone" class="form-control" placeholder="+1 234 567 8900" autocomplete="tel">
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="eq-date">Travel Date</label>
                  <input type="date" id="eq-date" name="travel_date" class="form-control">
                </div>
                <div class="form-group">
                  <label for="eq-group">Group Size</label>
                  <input type="number" id="eq-group" name="group_size" class="form-control" placeholder="2" min="1" max="20">
                </div>
              </div>
              <div class="form-group">
                <label for="eq-msg">Special Requests</label>
                <textarea id="eq-msg" name="message" class="form-control" rows="3" placeholder="Dietary needs, accessibility, etc."></textarea>
              </div>
              <button type="submit" class="btn btn-primary td-book-submit">
                Enquire now <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
              </button>
            </form>
            <div id="enquiry-success" class="td-book-success" hidden>
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              <p>Enquiry sent!</p>
              <p>We'll be in touch within 24 hours.</p>
            </div>
          </div>
        </div>
      </aside>

    </div>

    <!-- Related tours -->
    <% if (relatedTours.length > 0) { %>
    <section class="td-related reveal" aria-labelledby="td-related-h">
      <h2 class="td-h2" id="td-related-h"><span class="td-h2-icon"><i class="fa-solid fa-route" aria-hidden="true"></i></span>You may also like</h2>
      <div class="td-related-grid">
        <% relatedTours.forEach(t => { %>
          <%- include('partials/tour-card', { tour: t }) %>
        <% }) %>
      </div>
    </section>
    <% } %>

  </div>
</section>

<!-- Sticky enquiry bar (tablet / phone; behaviour in main.js) -->
<div class="sticky-cta is-hidden" id="sticky-cta">
  <div class="sticky-cta-info">
    <span>Duration</span>
    <strong><%= tour.duration %></strong>
  </div>
  <a href="#enquire-form" class="btn btn-primary btn-sm">Enquire now <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
</div>
