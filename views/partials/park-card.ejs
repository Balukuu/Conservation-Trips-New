<%
  // A national park: photo, facts, description, and the safaris that actually visit it
  // (park.tours / park.tourCount come from parksWithTours() in lib/pages.js).
  const more = park.tourCount - park.tours.length;
%>
<article class="ds-park">
  <div class="ds-park-photo">
    <%- image({ src: park.image, alt: park.name, sizes: '(min-width: 1100px) 380px, (min-width: 640px) 50vw, 100vw', fill: true }) %>
  </div>
  <div class="ds-park-body">
    <h3><%= park.name %></h3>
    <ul class="ds-park-facts">
      <li><i class="fa-solid fa-ruler-combined" aria-hidden="true"></i> <%= park.area %></li>
      <li><i class="fa-regular fa-calendar" aria-hidden="true"></i> <span>Best: <%= park.bestTime %></span></li>
    </ul>
    <p class="ds-park-desc"><%= park.description %></p>
    <p class="ds-park-highlights"><i class="fa-solid fa-star" aria-hidden="true"></i> <%= park.highlights %></p>

    <div class="ds-park-tours">
      <% if (park.tours.length) { %>
      <p class="ds-park-tours-label">Safaris that visit</p>
      <ul>
        <% park.tours.forEach(t => { %>
        <li><a href="/tours/<%= t.slug %>"><span><%= t.name %></span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></li>
        <% }) %>
      </ul>
      <% if (more > 0) { %><a class="ds-park-more" href="/tours">and <%= more %> more on our tours page</a><% } %>
      <% } else { %>
      <p class="ds-park-tours-label">Not on a set itinerary yet</p>
      <a class="ds-park-more" href="/contact">Ask us to build a safari here <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <% } %>
    </div>
  </div>
</article>
