<%
  // tour.price is authored as "From $700 pp". Split it so the label, the figure and
  // the unit can be styled separately (falls back to the raw string if it differs).
  const rawPrice = String(tour.price || '').trim();
  const fromMatch = rawPrice.match(/^from\s+(.+)$/i);
  let priceValue = fromMatch ? fromMatch[1] : rawPrice;
  const perPerson = /\s*(pp|per person)\s*$/i.test(priceValue);
  priceValue = priceValue.replace(/\s*(pp|per person)\s*$/i, '');
%>
<article class="tour-card" data-category="<%= tour.category %>">
  <div class="tour-card-img">
    <img
      src="<%= tour.image %>"
      alt=""
      loading="lazy"<% if (tour.imagePosition) { %>
      style="object-position: <%= tour.imagePosition %>"<% } %>
      onerror="this.src='/images/lion.png'"
    >
    <div class="tour-card-img-overlay"></div>
    <span class="category-tag"><%= tour.category %></span>
    <span class="duration-badge"><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= tour.duration %></span>
  </div>
  <div class="tour-card-body">
    <h3 class="tour-card-title">
      <a href="/tours/<%= tour.slug %>"><%= tour.name %></a>
    </h3>
    <p class="tour-card-excerpt"><%= tour.summary %></p>
    <div class="tour-card-footer">
      <div class="tour-card-price">
        <% if (fromMatch) { %><span class="tour-card-price-label">From</span><% } %>
        <span class="tour-card-price-value"><%= priceValue %><% if (perPerson) { %> <small>per person</small><% } %></span>
      </div>
      <span class="tour-card-cta" aria-hidden="true">View itinerary <i class="fa-solid fa-arrow-right"></i></span>
    </div>
  </div>
</article>
