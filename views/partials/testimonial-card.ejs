<div class="testimonial-card">
  <div class="testimonial-card-inner">
    <div class="testimonial-stars stars">★★★★★</div>
    <span class="testimonial-quote-mark">&ldquo;</span>
    <p class="testimonial-text"><%= testimonial.quote %></p>
    <div class="testimonial-author">
      <% if (testimonial.photo) { %>
      <%- image({ src: testimonial.photo, alt: testimonial.name, sizes: '58px', className: 'testimonial-avatar' }) %>
      <% } else { %>
      <span class="testimonial-avatar testimonial-avatar--initials" aria-hidden="true"><%= initials(testimonial.name) %></span>
      <% } %>
      <div>
        <div class="testimonial-author-name"><%= testimonial.name %></div>
        <div class="testimonial-author-country"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= testimonial.country %></div>
        <div class="testimonial-tour"><%= testimonial.tour %></div>
      </div>
    </div>
  </div>
</div>
