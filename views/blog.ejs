<%
  const articles = n => n === 1 ? '1 article' : n + ' articles';
%>
<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero bl-hero">
  <div class="page-hero-bg"><%- image({ src: '/images/gorilla.jpg', alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>Blog</span></nav>
    <h1>Safari Insights &amp; Travel Tips</h1>
    <p class="sx-hero-sub">Expert guides, wildlife stories, packing tips, and conservation news from East Africa.</p>
    <ul class="sx-chips">
      <li><i class="fa-regular fa-newspaper" aria-hidden="true"></i> <%= articles(blogStats.articles) %></li>
      <li><i class="fa-solid fa-tags" aria-hidden="true"></i> <%= blogStats.topics %> topics</li>
    </ul>
  </div>
</section>

<!-- ═══════════════ ARTICLES ═══════════════ -->
<section class="sx" id="articles">
  <div class="container">
    <header class="sx-head reveal">
      <div>
        <span class="sx-eyebrow">The journal</span>
        <h2>Guides, stories and travel tips</h2>
        <p>Written by the people who plan and guide your safari, so you arrive knowing what to expect.</p>
      </div>
      <p class="sx-count" role="status" data-blog-count><%= articles(visibleCount) %></p>
    </header>

    <!-- Category tabs: real links, so every topic has its own address (blog.js filters in place) -->
    <div class="reveal">
      <div class="filter-tabs sx-tabs" role="tablist" aria-label="Filter articles">
        <% tabs.forEach(tab => { %>
        <a href="<%= tab.href %>" class="filter-tab <%= activeCategory === tab.category ? 'active' : '' %>" data-category="<%= tab.category %>" role="tab" aria-selected="<%= activeCategory === tab.category %>">
          <span><%= tab.category %></span>
          <span class="sx-tab-count" aria-hidden="true"><%= tab.count %></span>
        </a>
        <% }) %>
      </div>
    </div>

    <% if (posts.length > 0) { %>
    <div class="bl-grid reveal-grid">
      <% posts.forEach(post => { %>
      <article class="bl-card" data-category="<%= post.category %>"<%= activeCategory !== 'All' && post.category !== activeCategory ? ' hidden' : '' %>>
        <a href="/blog/<%= post.slug %>" class="bl-card-img" tabindex="-1" aria-hidden="true">
          <%- image({ src: post.image, alt: '', sizes: '(min-width: 1100px) 380px, (min-width: 640px) 50vw, 100vw', fill: true }) %>
          <span class="bl-tag"><%= post.category %></span>
        </a>
        <div class="bl-card-body">
          <p class="bl-meta">
            <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= post.date %></span>
            <span><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= post.readTime %></span>
          </p>
          <h2 class="bl-card-title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="bl-excerpt"><%= post.excerpt %></p>
          <span class="bl-more" aria-hidden="true">Read article <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </article>
      <% }) %>
    </div>
    <% } else { %>
    <div class="bl-empty">
      <span class="bl-empty-icon"><i class="fa-solid fa-newspaper" aria-hidden="true"></i></span>
      <h3>No articles yet</h3>
      <p>We are writing the next one. In the meantime, browse our safari packages.</p>
      <a href="/tours" class="btn btn-green">Browse tours</a>
    </div>
    <% } %>
  </div>
</section>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: 'alt',
  title: 'Ready to live your safari story?',
  text: "Stop reading about it. Let us plan your perfect Uganda adventure. Talk to our safari experts today.",
  primary: { href: '/tours', label: 'Explore our tours' },
  secondary: { href: '/contact', label: 'Plan my safari' }
}) %>
