<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero">
  <div class="page-hero-bg"><%- image({ src: '/images/photos/coaster-guides.webp', alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>About Us</span></nav>
    <h1>About Conservation Trips &amp; Adventures</h1>
    <p class="sx-hero-sub">Uganda's premier safari company, crafting life-changing East Africa journeys since 2008.</p>
    <ul class="sx-chips">
      <li><i class="fa-solid fa-flag" aria-hidden="true"></i> Proudly Ugandan</li>
      <li><i class="fa-solid fa-leaf" aria-hidden="true"></i> Conservation-first</li>
      <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Licensed &amp; insured</li>
      <li><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Since 2008</li>
    </ul>
  </div>
</section>

<!-- ═══════════════ OUR STORY ═══════════════ -->
<section class="sx" id="story">
  <div class="container">
    <div class="sx-split ab-story">
      <div class="reveal-left">
        <span class="sx-eyebrow">Our story</span>
        <h2>Pioneering conservation tourism in Uganda</h2>
        <p class="sx-lead">
          Conservation Trips and Adventures is Uganda's premier safari and adventure travel company. Since 2008, we have been crafting life-changing experiences, with a dedication to excellence, safety and conservation at our core.
        </p>
        <p class="ab-prose">
          As a fully-fledged travel, tourism and conservation management company, we cater for both regional and global clients. We are proudly local, deeply knowledgeable, and passionate about sharing Uganda's extraordinary natural and cultural heritage with the world.
        </p>
        <p class="ab-prose">
          Our team of certified guides, naturalists and logistics specialists combine insider knowledge with international service standards, so every journey exceeds expectations. From selecting the finest lodges to securing sought-after gorilla permits, every detail is handled with expert care.
        </p>
        <blockquote class="ab-quote">
          &ldquo;Your prime tour and travel partner bringing exceptional experiences in Uganda and beyond.&rdquo;
        </blockquote>
        <div class="flex-center gap-16 flex-wrap" style="justify-content:flex-start;">
          <a href="/tours" class="btn btn-green">Explore our tours <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/contact" class="btn btn-outline-dark">Talk to us</a>
        </div>
      </div>

      <div class="sx-collage reveal-right">
        <div class="sx-collage-main">
          <%- image({ src: '/images/photos/coaster-guides.webp', sizes: '(min-width: 1024px) 40vw, 90vw', fill: true }) %>
        </div>
        <div class="sx-collage-sub">
          <%- image({ src: '/images/photos/guide-portrait.webp', sizes: '(min-width: 1024px) 18vw, 40vw', fill: true }) %>
        </div>
        <div class="sx-badge">
          <strong>Since 2008</strong>
          <span>Locally owned and run</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ MISSION / VISION / VALUES ═══════════════ -->
<section class="ab-pillars" id="mission">
  <div class="container">
    <div class="ab-pillars-grid reveal-grid">
      <article class="ab-pillar">
        <span class="ab-pillar-icon"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></span>
        <h3>Our mission</h3>
        <p>To provide world-class, sustainable safari and adventure experiences that connect people with Africa's extraordinary wildlife while supporting conservation and local communities.</p>
      </article>
      <article class="ab-pillar">
        <span class="ab-pillar-icon"><i class="fa-solid fa-eye" aria-hidden="true"></i></span>
        <h3>Our vision</h3>
        <p>To be East Africa's most trusted and impactful tour operator, inspiring travellers worldwide to experience the continent's majesty while protecting it for future generations.</p>
      </article>
      <article class="ab-pillar">
        <span class="ab-pillar-icon"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
        <h3>Our values</h3>
        <p>Conservation first. Integrity always. Excellence in every detail. Community empowerment. Safety without compromise. Authentic experiences over manufactured ones.</p>
      </article>
    </div>
  </div>
</section>

<!-- ═══════════════ WHY CHOOSE US ═══════════════ -->
<%
  const whyItems = [
    { icon: 'fa-shield-halved', title: 'Integrity & safety', desc: 'Your safety is our top priority. We plan every aspect, from transport to accommodation, with rigorous safety protocols and emergency plans in place.' },
    { icon: 'fa-user-graduate', title: 'Professional guides', desc: 'Knowledgeable, professional guides bring every destination alive with expertise and passion, for a seamless adventure.' },
    { icon: 'fa-map-location-dot', title: 'Local expertise', desc: 'As a proudly local Ugandan company, we offer an authentic perspective that unlocks hidden gems and cultural insights no outside operator can match.' },
    { icon: 'fa-truck-monster', title: 'Exclusive vehicles', desc: 'Custom 4x4 safari vehicles with pop-up roofs, USB charging, cooler boxes and first-aid kits, built for comfort and wildlife viewing.' },
    { icon: 'fa-sliders', title: 'Tailored experiences', desc: 'Your journey, your way. Every safari is customised to your preferences, travel style, group size and budget.' },
    { icon: 'fa-seedling', title: 'Sustainable tourism', desc: 'We are committed to conservation and responsible tourism, protecting natural resources, wildlife and the cultural heritage of East Africa.' }
  ];
%>
<section class="sx sx--alt" id="why">
  <div class="container">
    <header class="sx-head sx-head--center reveal">
      <div>
        <span class="sx-eyebrow">Why travel with us</span>
        <h2>Since 2008, we've been doing this right</h2>
        <p>Creating life-changing safari experiences with a dedication to excellence, safety and conservation at our core.</p>
      </div>
    </header>

    <div class="ab-values reveal-grid">
      <% whyItems.forEach((item, i) => { %>
      <article class="ab-value">
        <span class="ab-value-icon"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i></span>
        <h3><%= item.title %></h3>
        <p><%= item.desc %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ THE CREW ON THE ROAD ═══════════════ -->
<section class="sx" id="crew">
  <div class="container-wide">
    <header class="sx-head reveal">
      <div>
        <span class="sx-eyebrow">On the road with the team</span>
        <h2>The people behind your journey</h2>
        <p>Our guides, drivers and trip advisors on the road to the western parks, with a stop at the Equator.</p>
      </div>
      <a class="sx-link" href="/gallery/the-coaster">More from the road <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="ab-crew reveal-grid">
      <% crew.forEach(c => { %>
      <figure class="ab-crew-item ab-crew-item--<%= c.shape %>">
        <%- image({ src: c.src, alt: '', sizes: c.shape === 'feature' || c.shape === 'wide' ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw', fill: true }) %>
        <figcaption><%= c.caption %></figcaption>
      </figure>
      <% }) %>
      <a class="ab-crew-cta" href="/gallery">
        <strong>See the gallery</strong>
        <span>Photographs from our own journeys</span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════ TEAM ═══════════════ -->
<section class="sx sx--alt" id="team">
  <div class="container">
    <header class="sx-head sx-head--center reveal">
      <div>
        <span class="sx-eyebrow">Our team</span>
        <h2>Meet our expert guides &amp; team</h2>
      </div>
    </header>

    <div class="ab-team reveal-grid">
      <% team.forEach(member => { %>
      <article class="ab-member">
        <div class="ab-member-photo">
          <%- image({ src: member.img, alt: member.name, sizes: '(min-width: 1024px) 260px, (min-width: 560px) 45vw, 90vw', fill: true }) %>
        </div>
        <div class="ab-member-body">
          <h3><%= member.name %></h3>
          <p class="ab-member-role"><%= member.role %></p>
          <p class="ab-member-bio"><%= member.bio %></p>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ REGISTERED ═══════════════ -->
<section class="sx" id="registered">
  <div class="container">
    <div class="ab-creds">
      <div class="reveal-left">
        <span class="sx-eyebrow">Licensed &amp; accountable</span>
        <h2>Registered with the bodies that protect Uganda's tourism and wildlife</h2>
        <p class="sx-lead">
          We are registered with the Uganda Tourism Board and the Uganda Wildlife Authority, with rigorous safety protocols in place throughout every journey. Your safety is our top priority.
        </p>
      </div>
      <ul class="ab-logos reveal-right">
        <li>
          <%- image({ src: '/images/utb.png', sizes: '200px', className: 'ab-logo ab-logo--wide' }) %>
          <span>Uganda Tourism Board</span>
        </li>
        <li>
          <%- image({ src: '/images/uwa.png', sizes: '110px', className: 'ab-logo' }) %>
          <span>Uganda Wildlife Authority</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<section class="sx sx--alt sx-cta" id="cta">
  <div class="container">
    <div class="sx-cta-card reveal">
      <div>
        <h2>Ready for your African adventure?</h2>
        <p>Let our expert team craft your perfect safari. Whether it's gorillas in Bwindi, the summit of Kilimanjaro, or a custom multi-country journey, we make it seamless.</p>
        <div class="flex-center gap-16 flex-wrap" style="justify-content:flex-start;">
          <a href="/tours" class="btn btn-primary btn-lg">Browse all tours <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/contact" class="btn btn-outline btn-lg">Get a custom quote</a>
        </div>
      </div>
      <ul class="sx-cta-contacts">
        <li><a href="tel:+256767936590"><i class="fa-solid fa-phone" aria-hidden="true"></i><span><small>Call us</small>+256 767 936 590</span></a></li>
        <li><a href="https://wa.me/256767936590" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span><small>WhatsApp</small>Chat with a trip advisor</span></a></li>
        <li><a href="mailto:info@tripsandadventures.co.ug"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span><small>Email</small>info@tripsandadventures.co.ug</span></a></li>
      </ul>
    </div>
  </div>
</section>
