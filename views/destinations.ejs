<%
  const s = destStats;
  const plural = (n, one, many) => n + ' ' + (n === 1 ? one : many);
%>
<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero ds-hero">
  <div class="page-hero-bg"><%- image({ src: '/images/lion.jpg', alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <span>Destinations</span></nav>
    <h1>Uganda's National Parks &amp; East Africa Destinations</h1>
    <p class="sx-hero-sub">From gorilla sanctuaries to snowcapped peaks, explore the most extraordinary destinations in East Africa.</p>
    <ul class="sx-chips">
      <li><i class="fa-solid fa-earth-africa" aria-hidden="true"></i> <%= plural(s.countries, 'country', 'countries') %></li>
      <li><i class="fa-solid fa-tree" aria-hidden="true"></i> <%= plural(s.parks, 'national park', 'national parks') %> in Uganda</li>
      <li><i class="fa-solid fa-route" aria-hidden="true"></i> <%= plural(s.tours, 'safari package', 'safari packages') %></li>
    </ul>
  </div>
</section>

<!-- ═══════════════ COUNTRIES ═══════════════ -->
<section class="sx" id="countries">
  <div class="container">
    <header class="sx-head sx-head--center reveal">
      <div>
        <span class="sx-eyebrow">Countries we cover</span>
        <h2>Choose your destination</h2>
        <p>Four countries, one team. Pick where you want to go and see the safaris we run there.</p>
      </div>
    </header>

    <div class="ds-countries reveal-grid">
      <% destinations.forEach(dest => { %>
      <a href="/destinations/<%= dest.slug %>" class="ds-country">
        <span class="ds-country-photo"><%- image({ src: dest.image, alt: '', sizes: '(min-width: 1100px) 290px, (min-width: 640px) 50vw, 100vw', fill: true }) %></span>
        <span class="ds-country-shade"></span>
        <span class="ds-country-body">
          <span class="ds-country-region"><%= dest.subtitle %></span>
          <span class="ds-country-name"><%= dest.name %></span>
          <span class="ds-country-tag"><%= dest.tagline %></span>
          <span class="ds-country-foot">
            <span><%= plural(dest.tourCount, 'tour', 'tours') %></span>
            <span class="ds-country-go" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
          </span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════ UGANDA'S PARKS ═══════════════ -->
<% if (parks.length) { %>
<section class="sx sx--alt" id="parks">
  <div class="container">
    <header class="sx-head reveal">
      <div>
        <span class="sx-eyebrow">The Pearl of Africa</span>
        <h2>Uganda's national parks</h2>
        <p>Uganda is one of the most biodiverse countries on Earth: home to half the world's mountain gorillas, the chimpanzee capital of the world, and over 1,000 bird species.</p>
      </div>
      <a class="sx-link hide-mobile" href="/tours">All safari packages <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <div class="ds-parks reveal-grid">
      <% parks.forEach(park => { %>
        <%- include('partials/park-card', { park }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: parks.length ? 'plain' : 'alt',
  title: 'Ready to explore East Africa?',
  text: 'Let our expert team craft your personalised safari itinerary. Contact us today and start your adventure.',
  primary: { href: '/tours', label: 'Browse all tours' },
  secondary: { href: '/contact', label: 'Get a custom quote' }
}) %>
