<!-- ═══════════════ HERO ═══════════════ -->
<section class="page-hero sx-hero bl-hero bl-hero--post">
  <div class="page-hero-bg"><%- image({ src: post.image, alt: '', sizes: '100vw', priority: true, fill: true }) %></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-angle-right"></i> <a href="/blog">Blog</a> <i class="fa-solid fa-angle-right"></i> <span><%= post.category %></span></nav>
    <a href="<%= categoryUrl('blog', post.category) %>" class="badge badge-accent bl-hero-badge"><%= post.category %></a>
    <h1><%= post.title %></h1>
    <ul class="sx-chips">
      <li><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= post.date %></li>
      <li><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= post.readTime %></li>
      <li><i class="fa-solid fa-pen" aria-hidden="true"></i> <%= post.author %></li>
    </ul>
  </div>
</section>

<!-- ═══════════════ ARTICLE ═══════════════ -->
<section class="sx" id="article">
  <div class="container">
    <div class="bl-layout">

      <article class="bl-article reveal">
        <p class="bl-lead"><%= post.excerpt %></p>

        <div class="bl-prose">
          <% articleBody.forEach(block => { %>
            <% if (block.type === 'h2') { %><h2><%= block.text %></h2>
            <% } else { %><p><%= block.text %></p>
            <% } %>
          <% }) %>
        </div>

        <aside class="bl-note">
          <h3><i class="fa-solid fa-leaf" aria-hidden="true"></i> Conservation note</h3>
          <p>Every safari we organise contributes directly to Uganda's conservation efforts and local community livelihoods. Travel with us is travel that gives back.</p>
        </aside>

        <div class="bl-share">
          <span class="bl-share-label">Share</span>
          <div class="share-buttons">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(siteUrl + meta.path) %>" target="_blank" rel="noopener" class="share-btn share-fb"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook</a>
            <a href="https://wa.me/?text=<%= encodeURIComponent(post.title + ': ' + siteUrl + meta.path) %>" target="_blank" rel="noopener" class="share-btn share-wa"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp</a>
          </div>
        </div>
      </article>

      <aside class="bl-aside" aria-label="Plan your safari and related articles">
        <div class="bl-plan">
          <h2>Plan your safari</h2>
          <p>Ready to experience Uganda for yourself? Our team of experts is ready to craft your perfect itinerary.</p>
          <a href="/contact" class="btn btn-primary">Get a free quote <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/tours" class="btn btn-outline">View all tours</a>
          <a href="tel:+256767936590" class="bl-plan-phone"><i class="fa-solid fa-phone" aria-hidden="true"></i> +256 767 936 590</a>
        </div>

        <% if (related && related.length > 0) { %>
        <div class="bl-related">
          <h2>Related articles</h2>
          <ul>
            <% related.forEach(r => { %>
            <li>
              <a href="/blog/<%= r.slug %>">
                <span class="bl-related-img"><%- image({ src: r.image, alt: '', sizes: '84px', fill: true }) %></span>
                <span class="bl-related-text">
                  <strong><%= r.title %></strong>
                  <small><%= r.readTime %></small>
                </span>
              </a>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
      </aside>

    </div>
  </div>
</section>

<!-- ═══════════════ CALL TO ACTION ═══════════════ -->
<%- include('partials/cta-card', {
  tone: 'alt',
  title: "Inspired? Let's plan your safari",
  text: 'Our expert team is ready to craft your perfect Uganda adventure. Get in touch today; we respond within 24 hours.',
  primary: { href: '/contact', label: 'Start planning' },
  secondary: { href: '/tours', label: 'Browse tours' }
}) %>
