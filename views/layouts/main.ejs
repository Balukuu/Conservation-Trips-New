<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Runs before first paint:
       .js            → scroll-reveal content may be hidden (no-JS visitors always see it)
       .cookies-ok    → returning visitors never get the cookie banner (no slide-down flash) -->
  <script>
    (function (d) {
      d.documentElement.classList.add('js');
      try { if (localStorage.getItem('cookiesAccepted') === 'true') d.documentElement.classList.add('cookies-ok'); } catch (e) {}
    })(document);
  </script>
  <%
    // meta.path is the page's site-relative URL (absent on the 404/500 pages, which
    // shouldn't declare a canonical). Static builds serve folders, so they end in "/".
    const pageUrl = meta.path == null ? '' : siteUrl + meta.path + (typeof staticBuild !== 'undefined' && staticBuild && meta.path !== '/' ? '/' : '');
    // Social cards want a 1200×630 crop; ogImageFor() returns it when one was generated.
    const ogSrc = ogImageFor(meta.ogImage);
    const ogImage = /^https?:\/\//.test(ogSrc) ? ogSrc : siteUrl + ogSrc;
    // Everything under /images/og/ is exactly 1200×630; declaring it lets crawlers show the large card on first share.
    const ogSized = ogSrc.startsWith('/images/og/');
  %>
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <% if (meta.keywords) { %><meta name="keywords" content="<%= meta.keywords %>">
  <% } %><% if (pageUrl) { %><link rel="canonical" href="<%= pageUrl %>">
  <% } %>
  <!-- Open Graph -->
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:image" content="<%= ogImage %>">
  <% if (ogSized) { %><meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% } %><meta property="og:image:alt" content="<%= meta.title %>">
  <% if (pageUrl) { %><meta property="og:url" content="<%= pageUrl %>">
  <% } %><meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Conservation Trips & Adventures">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= meta.title %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <!-- Favicon (small PNGs generated from the logo by `npm run images`) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icons/favicon-192.png">
  <link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png">

  <!-- Font: Figtree, self-hosted (see main.css). Preloaded so text paints in it at once. -->
  <link rel="preload" href="/fonts/figtree-v9-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Font Awesome icons come from cdnjs: connect early -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <% if (typeof useFlags !== 'undefined' && useFlags) { %>
  <!-- Flag Icons (only the pages that show country flags) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css">
  <% } %>

  <!-- Styles (assetUrl adds a content hash, so they can be cached long-term) -->
  <link rel="stylesheet" href="<%= assetUrl('/css/main.css') %>">
  <link rel="stylesheet" href="<%= assetUrl('/css/animations.css') %>">
  <link rel="stylesheet" href="<%= assetUrl('/css/components.css') %>">
  <% (typeof pageStyles !== 'undefined' ? pageStyles : []).forEach(href => { %>
  <link rel="stylesheet" href="<%= assetUrl(href) %>">
  <% }) %>
  <!-- Reduced motion / transparency / contrast — keep LAST so it wins -->
  <link rel="stylesheet" href="<%= assetUrl('/css/preferences.css') %>">

  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>

  <%- include('../partials/navbar') %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Floating WhatsApp -->
  <div class="whatsapp-float">
    <span class="whatsapp-tooltip" aria-hidden="true">Chat on WhatsApp</span>
    <a class="whatsapp-btn" href="https://wa.me/256767936590?text=Hello%20Conservation%20Trips%20%26%20Adventures!%20I%27m%20interested%20in%20booking%20a%20Uganda%20safari.%20Can%20you%20help%20me%20plan%20my%20trip%3F" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <i class="fa-brands fa-whatsapp"></i>
    </a>
  </div>

  <!-- Back to Top -->
  <button class="back-to-top" aria-label="Back to top">
    <i class="fa-solid fa-chevron-up"></i>
  </button>

  <!-- Menu Backdrop -->
  <div class="menu-backdrop"></div>

  <!-- Lightbox -->
  <div class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image gallery">
    <div class="lightbox-inner">
      <button class="lightbox-close" aria-label="Close gallery"><i class="fa-solid fa-xmark"></i></button>
      <button class="lightbox-nav lightbox-prev" aria-label="Previous image"><i class="fa-solid fa-chevron-left"></i></button>
      <img src="" alt="">
      <button class="lightbox-nav lightbox-next" aria-label="Next image"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
    <div class="lightbox-count" aria-live="polite"></div>
  </div>

  <!-- Scripts (order matters: motion.js first; defer keeps it while unblocking the parser) -->
  <% ['motion', 'main', 'slider', 'lightbox', 'tours', 'blog', 'booking'].forEach(name => { %>
  <script defer src="<%= assetUrl('/js/' + name + '.js') %>"></script>
  <% }) %>

  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
