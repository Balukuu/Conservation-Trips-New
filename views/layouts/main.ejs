<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <meta name="keywords" content="<%= meta.keywords %>">
  <link rel="canonical" href="<%= meta.ogUrl %>">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:image" content="<%= meta.ogImage %>">
  <meta property="og:url" content="<%= meta.ogUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Conservation Trips & Adventures">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= meta.title %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <meta name="twitter:image" content="<%= meta.ogImage %>">

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/images/logonew.jpeg">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Flag Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/components.css">

  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>

  <%- include('../partials/navbar') %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Floating WhatsApp -->
  <div class="whatsapp-float">
    <span class="whatsapp-tooltip">Chat on WhatsApp</span>
    <a class="whatsapp-btn" href="https://wa.me/256767936590?text=Hello%20Conservation%20Trips%20%26%20Adventures!%20I%27m%20interested%20in%20booking%20a%20Uganda%20safari.%20Can%20you%20help%20me%20plan%20my%20trip%3F" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <i class="fa-brands fa-whatsapp"></i>
    </a>
  </div>

  <!-- Back to Top -->
  <button class="back-to-top" aria-label="Back to top">
    <i class="fa-solid fa-chevron-up"></i>
  </button>

  <!-- Menu Backdrop -->
  <div class="menu-backdrop"></div>

  <!-- Lightbox -->
  <div class="lightbox-overlay" role="dialog" aria-modal="true">
    <div class="lightbox-inner">
      <button class="lightbox-close" aria-label="Close lightbox"><i class="fa-solid fa-xmark"></i></button>
      <button class="lightbox-nav lightbox-prev" aria-label="Previous image"><i class="fa-solid fa-chevron-left"></i></button>
      <img src="" alt="Gallery image">
      <button class="lightbox-nav lightbox-next" aria-label="Next image"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/slider.js"></script>
  <script src="/js/lightbox.js"></script>
  <script src="/js/tours.js"></script>
  <script src="/js/booking.js"></script>

  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
