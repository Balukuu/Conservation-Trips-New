PORT=3000
NODE_ENV=development

# Public origin (including any base path). Used for canonical / Open Graph /
# share URLs. Defaults to https://tripsandadventures.co.ug
# SITE_URL=https://tripsandadventures.co.ug

# Behind nginx / Passenger the app trusts one proxy hop in production so rate
# limiting sees real visitor IPs. Override with a hop count, true/false or a subnet.
# TRUST_PROXY=1

# Email for enquiry forms (nodemailer). Without these the forms are accepted in
# development but nothing is sent, and in production they answer 503.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=yourpassword
# CONTACT_EMAIL=info@tripsandadventures.co.ug
